// M58 — Bloom downsample pass.
//
// 4-tap **2×2** box filter that halves the resolution: each destination
// texel is the plain average of the four source texels under it.
//
// #4311 — this header used to claim the four taps "cover an effective 4×4
// source region" and were "provably equivalent to a 4×4 box filter". The
// geometry says otherwise, and the offsets are in *source* texels, not
// destination ones:
//
//   Destination texel `i` has its centre at source coordinate
//   `(i + 0.5) · 2 = 2i + 1` — the shared corner of source texels `2i` and
//   `2i+1`. A ±0.5 *source*-texel offset lands on `2i+0.5` and `2i+1.5`,
//   which are exactly those two texel centres. Each bilinear tap therefore
//   degenerates to a single-texel point sample, and the four together
//   average precisely the 2×2 footprint with no overlap between neighbouring
//   destination texels.
//
// The 4×4 the old text described needs ±1.0 source-texel offsets: those put
// each tap on a texel *corner*, where bilinear genuinely averages 2×2, so
// four taps span 4×4 with the overlap that makes the chain stable. That is a
// one-character change per tap and a real quality question — a
// non-overlapping 2×2 chain is the downsample known to make small bright
// features pulse as they cross texel boundaries under sub-pixel motion, and
// since the soft-knee bright-pass (`62a09fd9`) bloom is dominated by exactly
// those features. It is deliberately **not** made here: it is a
// visually-consequential change whose severity needs an in-engine A/B under
// motion, which a static capture cannot show and no test can assert.
// `bloom.rs`'s `downsample_taps_match_the_documented_footprint` pins the two
// halves together so the claim and the offsets cannot drift apart again.
//
// Why a box filter at all, instead of Jimenez's 13-tap or Bjørge's
// dual-filter Kawase: the 13-tap weights need to be lifted from the
// SIGGRAPH 2014 talk verbatim and we don't have the slides in the
// repo right now; "make up reasonable weights" violates the
// no-guessing rule. A box filter is mathematically unambiguous, costs 4
// texture lookups, has 0 floating-point weights to maintain, and can be
// upgraded when we have the reference open. See the M58 row in ROADMAP.md
// for tracking.
//
// Reference: Bjørge, "Bandwidth-Efficient Rendering," SIGGRAPH 2015,
// §3.2 — the simpler "down 4 / up 4" variant before the dual-filter
// upgrade.
#version 450
#extension GL_GOOGLE_include_directive : require

// Shared constants — generated by crates/renderer/build.rs.
#include "include/shader_constants.glsl"

layout(local_size_x = WORKGROUP_X, local_size_y = WORKGROUP_Y) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;

layout(set = 0, binding = 2) uniform Params {
    // xy = 1 / source resolution (used to offset taps)
    // zw = 1 / destination resolution (used to compute uv at center
    //      of destination texel)
    vec4 inv_resolutions;
    // x = bright-pass enable (1.0 on the level seeded from the scene
    //     image, 0.0 on every deeper level). yzw unused.
    //
    // The knee must run EXACTLY ONCE, on the seed. Re-applying it per
    // level would compose the curve with itself four more times and
    // crush everything but the sun disc.
    vec4 bright_pass;
} params;

// Karis/Jimenez soft-knee bright-pass.
//
// Without this the pyramid has no threshold at all, so its "local blurred
// average" over a large uniform region converges to that region's own
// value and `scene += bloom * BLOOM_INTENSITY` stops being a highlight
// glow and becomes a flat gain. On an exterior frame the sky is the
// largest uniform bright region there is, and the measured result was a
// 1.71x multiply on the whole sky — enough to push it into the ACES
// shoulder and flatten both its gradient and its hue. See
// `shader_constants_data.rs`'s BLOOM_THRESHOLD note for the capture.
//
// Curve: quadratic ramp across `[THRESHOLD - KNEE, THRESHOLD + KNEE]`,
// linear above. Applied on the max channel and folded back in as a scale
// so the source hue is preserved rather than per-channel clipped.
vec3 bloom_bright_pass(vec3 c) {
    float brightest = max(c.r, max(c.g, c.b));
    float soft = clamp(brightest - BLOOM_THRESHOLD + BLOOM_KNEE, 0.0, 2.0 * BLOOM_KNEE);
    soft = soft * soft / (4.0 * BLOOM_KNEE + 1.0e-6);
    float contribution = max(soft, brightest - BLOOM_THRESHOLD);
    return c * (contribution / max(brightest, 1.0e-6));
}

void main() {
    ivec2 dst_coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(dst);
    if (any(greaterThanEqual(dst_coord, dst_size))) {
        return;
    }

    vec2 src_pixel = params.inv_resolutions.xy;
    vec2 dst_pixel = params.inv_resolutions.zw;
    vec2 uv = (vec2(dst_coord) + 0.5) * dst_pixel;

    vec3 t0 = texture(src, uv + vec2(-0.5, -0.5) * src_pixel).rgb;
    vec3 t1 = texture(src, uv + vec2( 0.5, -0.5) * src_pixel).rgb;
    vec3 t2 = texture(src, uv + vec2(-0.5,  0.5) * src_pixel).rgb;
    vec3 t3 = texture(src, uv + vec2( 0.5,  0.5) * src_pixel).rgb;

    // Threshold per tap, before the box average, so a single bright texel
    // inside the footprint still registers instead of being averaged below
    // the knee by its dark neighbours.
    if (params.bright_pass.x > 0.5) {
        t0 = bloom_bright_pass(t0);
        t1 = bloom_bright_pass(t1);
        t2 = bloom_bright_pass(t2);
        t3 = bloom_bright_pass(t3);
    }

    vec3 sum = t0 + t1 + t2 + t3;

    imageStore(dst, dst_coord, vec4(sum * 0.25, 1.0));
}
