// Procedural volumetric-lighting injection with RT visibility.
//
// For each froxel (uvw in volume space) compute the in-scattered
// radiance from directional and clustered local lights, modulated by
// Henyey-Greenstein phase functions and gated on ray-query visibility
// checks against the scene TLAS. Output is RGBA16F:
//   rgb = inscattered radiance (HDR linear, pre-tone-map)
//   a   = extinction coefficient (1 / world unit)
//
// Density samples boot-generated tileable Perlin-Worley base/detail volumes
// through a curl-warped domain. The base σ_t arrives from the engine-native
// XCLL/WTHR conversion table; slices use the shared 5 m linear floor plus
// exponential tail and raw V-buffer
// history is reprojected per froxel.
//
// Reference: Hillaire, "Physically based and unified volumetric
// rendering in Frostbite," SIGGRAPH 2015. The injection step is
// §5.2; phase function from §5.1 (Henyey-Greenstein, single-lobe);
// shadow visibility is the standard "trace toward light, miss = lit"
// test used by every modern RT volumetric path — but per froxel this
// is NOT a single ray. Worst case: 1 opaque sun ray, +1 glass-masked
// sun ray for interiors (disambiguating a missing-ceiling no-hit from
// a real window), then up to MAX_FROXEL_LIGHTS local lights x up to 2
// rays each (opaque mask, then glass mask) = up to 10 ray-query
// traversals per froxel. At the default froxel_xy_divisor=8 160x90x64
// grid (1280x720 render extent) that is a worst-case ~9.2M ray
// queries/frame from this pass alone. See
// REN-D16-2026-08-07-02 / #2509.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require

// Shared constants — generated by crates/renderer/build.rs.
#include "include/shader_constants.glsl"
// #3742 — BLUE_NOISE_RANKS, shared verbatim with composite.frag.
#include "include/blue_noise.glsl"

layout(local_size_x = WORKGROUP_X, local_size_y = WORKGROUP_Y, local_size_z = WORKGROUP_Z) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image3D froxel;

layout(set = 0, binding = 1) uniform VolumetricsParams {
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    // xyz = camera world position, w = extinction coefficient (1 / world unit)
    vec4 camera_pos;
    // xyz = previous camera world position, w = history-valid flag
    vec4 prev_camera_pos;
    // xyz = direction TO the sun (world space, unit length — matches
    // GpuLight.direction_angle / GpuCamera.sun_direction and every other
    // consumer in the renderer, #1937), w = HG phase function asymmetry
    // parameter g in (-1, 1).
    vec4 sun_dir;
    // rgb = sun radiance (already multiplied by intensity), a = unused
    vec4 sun_color;
    // x = volume far plane, y = 5 m linear floor, z = fraction of slices
    // assigned to that floor, w = frame index. Distances are world units.
    vec4 volume_params;
    // #markarth-precision — xyz = camera-relative render origin; added to the
    // inv_view_proj-reconstructed far point to recover ABSOLUTE froxel world
    // positions (the TLAS shadow rays below are cast in absolute space).
    // w = is_exterior (1.0 exterior, 0.0 interior) — selects the shadow-ray
    // strategy below.
    vec4 render_origin;
    // x = single-scatter albedo, y = backward HG g,
    // z = forward-lobe mix, w = exponential height scale.
    vec4 medium_params;
    // rgb = normalized authored CELL/WTHR fog chromaticity. Multiplying by
    // medium_params.x yields spectral single-scatter albedo while keeping
    // extinction and the authored peak scattering energy independent of hue.
    // a = sanitized authored fog-colour peak. rgb * a reconstructs the
    // apparent fog radiance used by the homogeneous equilibrium source term;
    // without it, sunless interiors only absorb light and their procedural
    // fog is effectively invisible.
    vec4 fog_tint;
    // x = history weight, y = density-change rejection strength,
    // z = total time seconds, w = procedural coverage.
    vec4 temporal_params;
    // xyz = minimum corner of the camera-centered local-volume cluster cube;
    // w = reciprocal cluster-cell size.
    vec4 local_volume_grid;
    // x = height-fog reference altitude (REN-D16-01 / #2225), absolute
    // world space matching camera_pos/render_origin — ground height near
    // the camera, or camera Y as a fallback. y = emissive history weight,
    // z = adaptive local-light cap, w = clamped simulation delta seconds.
    vec4 fog_reference;
    // xy = normalized horizontal wind direction in renderer X/Z space,
    // z = base speed and w = gust amplitude, in world units per second.
    vec4 wind_params;
    // x = gust cycles per second. Remaining lanes are reserved.
    vec4 wind_gust;
} params;

// Phase 2c — scene TLAS. Updated each frame from the host side via
// `VolumetricsPipeline::write_tlas` before dispatch. Used solely for
// shadow visibility from sample → sun; no closest-hit shading is
// needed because sun radiance is constant.
layout(set = 0, binding = 2) uniform accelerationStructureEXT topLevelAS;

#include "include/shadow_common.glsl"

// Phase 2b — point/spot light in-scattering. Bindings 3/4/5 mirror the
// SAME per-frame lights SSBO + cluster grid + light-index list
// `cluster_cull.comp` builds for the fragment shader (struct layouts
// copied from `include/bindings.glsl`'s `GpuLight` / `ClusterEntry` —
// not `#include`d wholesale since that file's bindings are numbered
// for the fragment shader's own descriptor set, not this compute
// shader's). Written per-frame via
// `VolumetricsPipeline::write_lights_and_clusters`.
struct GpuLight {
    vec4 position_radius; // xyz = position, w = radius
    vec4 color_type;       // rgb = color, w = type (0=point, 1=spot, 2=directional)
    vec4 direction_angle;  // xyz = direction, w = spot angle cosine
    vec4 params;           // x = falloff, y = source radius, z = visibility bits, w = attenuation model
};

layout(std430, set = 0, binding = 3) readonly buffer LightBuffer {
    uint lightCount;
    uint _pad0, _pad1, _pad2;
    GpuLight lights[];
};

struct ClusterEntry {
    uint offset;
    uint count;
};

layout(std430, set = 0, binding = 4) readonly buffer ClusterGrid {
    ClusterEntry clusters[];
};

layout(std430, set = 0, binding = 5) readonly buffer ClusterLightIndices {
    uint clusterLightIndices[];
};

// Previous frame's raw V-buffer (rgb in-scattering, a extinction), sampled
// after projecting the jittered current froxel center through prev_view_proj.
layout(set = 0, binding = 6) uniform sampler3D previousFroxel;

// Spatially bounded authored media. The CPU transforms ECS primitives to
// absolute world space, sorts them near-to-far, and builds a camera-centered
// 16^3 fixed-capacity cluster list every frame. This keeps the per-froxel loop
// bounded even in scenes with many legacy smoke systems.
struct GpuFogVolume {
    vec4 center_shape;             // xyz center, w 0 sphere / 1 ellipsoid / 2 box
    vec4 half_extents_extinction;  // xyz half extents, w sigma_t / world unit
    vec4 inverse_rotation;         // world-to-local quaternion
    vec4 albedo_edge;              // rgb single-scatter albedo, w edge softness
    vec4 emission_temperature;     // rgb emitted radiance L_e, w blackbody K
    vec4 profile_params;           // x profile; y normalized explosion age, z lifetime
};

layout(std430, set = 0, binding = 7) readonly buffer FogVolumeBuffer {
    uint fogVolumeCount;
    uint _fogPad0, _fogPad1, _fogPad2;
    GpuFogVolume fogVolumes[];
};

struct FogClusterEntry {
    uint offset;
    uint count;
};

layout(std430, set = 0, binding = 8) readonly buffer FogClusterBuffer {
    FogClusterEntry fogClusters[];
};

layout(std430, set = 0, binding = 9) readonly buffer FogClusterIndexBuffer {
    uint fogClusterIndices[];
};

layout(set = 0, binding = 10) uniform sampler3D baseDensityNoise;
layout(set = 0, binding = 11) uniform sampler3D detailDensityNoise;

// Current and previous deterministic emissive share. The raw V-buffer cannot
// reconstruct this after emission, authored fog, and stochastic lighting have
// been folded into one RGB source. Keeping one scalar history channel lets a
// departing flame retain the same short temporal time constant as its leading
// edge without treating binary shadow-ray changes as disocclusions. #2809.
layout(r32f, set = 0, binding = 12) uniform writeonly image3D emissionHistory;
layout(set = 0, binding = 13) uniform sampler3D previousEmissionHistory;

// Canonical transported combustion state. These fields deliberately contain
// no source-game identity: per-game particle/material authoring has already
// converged to GpuFogVolume::profile_params at the import boundary.
//
// chemistry = (fuel mass fraction, temperature K, total extinction sigma_t/world-unit,
//              visible-radiance calibration at 1850 K)
// dynamics  = (world-space velocity xyz in world-units/second,
//              specific overpressure in m²/s²)
// optical   = (spectral scattering sigma_s.rgb/world-unit, reserved zero)
//
// Current and previous slots are distinct frame-in-flight images, so this
// shader can semi-Lagrangian backtrace the old field while writing the new
// one without an intra-dispatch data hazard.
layout(rgba16f, set = 0, binding = 14) uniform writeonly image3D combustionState;
layout(set = 0, binding = 15) uniform sampler3D previousCombustionState;
layout(rgba16f, set = 0, binding = 16) uniform writeonly image3D combustionDynamics;
layout(set = 0, binding = 17) uniform sampler3D previousCombustionDynamics;
layout(rgba16f, set = 0, binding = 22) uniform writeonly image3D combustionOptical;
layout(set = 0, binding = 23) uniform sampler3D previousCombustionOptical;

// Coarse radiant moments of the *transported* field, consumed by the host on
// the next safe reuse of this frame-in-flight slot. This is the canonical
// bridge from participating-medium emission to surface lighting: no source
// primitive or source-game identity is visible here. Each 32-byte bin stores
// fixed-point total luma, luma-weighted bin-local centroid, RGB radiant
// intensity, and luminous volume. Rust owns the matching repr(C) layout.
struct CombustionLightMoment {
    uint weight;
    uint weighted_x;
    uint weighted_y;
    uint weighted_z;
    uint radiant_r;
    uint radiant_g;
    uint radiant_b;
    uint luminous_volume;
};

layout(std430, set = 0, binding = 18) buffer CombustionLightMomentBuffer {
    CombustionLightMoment combustionLightMoments[];
};

// Geometry backing the current TLAS. `instance_custom_index` is built from
// the same compacted index as this per-frame instance SSBO, so a committed
// ray-query hit can recover its triangle without a second scene map. Only the
// prefix needed for rigid boundary normals is named; the `_boundaryTail*`
// words cover the u64 skinned-vertex address, the two u64 morph-target
// addresses, the morph-target count and their reserved padding, preserving
// the exact 160-byte std430 stride of the canonical Rust `GpuInstance`.
//
// This is a deliberate prefix-mirror under its own name, so it sits outside
// `gpu_instance_glsl_copies_stay_in_lockstep`'s SOURCES list (which keys on
// the literal `struct GpuInstance`). The stride is instead pinned by
// `gpu_boundary_instance_stride_matches_gpu_instance` — the tail exists only
// to make the stride right, so agreeing on the total size is the whole
// contract. Growing `GpuInstance` without growing the tail here misaligns
// every read past instance index 0 (#3829).
struct GpuBoundaryInstance {
    mat4 model;
    uint textureIndex;
    uint boneOffset;
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint flags;
    uint materialId;
    float ior;
    float avgAlbedoR;
    float avgAlbedoG;
    float avgAlbedoB;
    uint surfaceId;
    // 112..128 — u64 skinned-vertex address + two reserved words.
    uvec4 _boundaryTail0;
    // 128..144 — u64 morph-delta address + u64 morph-weight address.
    uvec4 _boundaryTail1;
    // 144..160 — morph-target count + three reserved words.
    uvec4 _boundaryTail2;
};

layout(std430, set = 0, binding = 19) readonly buffer BoundaryInstanceBuffer {
    GpuBoundaryInstance boundaryInstances[];
};

layout(std430, set = 0, binding = 20) readonly buffer BoundaryVertexBuffer {
    float boundaryVertexData[];
};

layout(std430, set = 0, binding = 21) readonly buffer BoundaryIndexBuffer {
    uint boundaryIndexData[];
};

const float PI = 3.14159265358979323846;
// Rec. 709 luma weights, matching `byroredux_core::radiometry`'s
// `linear_srgb_luminance` so CPU and GPU agree on what "brightness" means.
const vec3 LUMA_REC709 = vec3(0.2126, 0.7152, 0.0722);
const float AMBIENT_TEMPERATURE_K = 293.15;
const float IGNITION_TEMPERATURE_K = 720.0;
const float MAX_COMBUSTION_TEMPERATURE_K = 4200.0;
const float MAX_COMBUSTION_SPEED_MPS = 28.0;
const float COMBUSTION_WALL_FRICTION_PER_SECOND = 0.35;
// FOG_VOLUME_CLUSTER_DIM / MAX_FOG_VOLUMES_PER_CLUSTER come from the
// #include'd shader_constants.glsl header (generated from
// shader_constants_data.rs — #2229 / REN-D3-02). Previously hand-declared
// here as local literals with no shared source with the Rust-side
// `vulkan::volumetrics` copies.

vec3 warpFogDomain(vec3 worldMetres, float timeSeconds);
float sampledDensity(vec3 metres, float baseScale, float detailScale);

vec3 rotateByQuaternion(vec3 value, vec4 q) {
    return value + 2.0 * cross(q.xyz, cross(q.xyz, value) + q.w * value);
}

// Accumulated coefficients of the radiative transfer equation contributed by
// authored local media at one froxel. Emission is carried separately from
// in-scattering because the two behave differently under temporal
// accumulation: in-scattering is a stochastic visibility estimate that WANTS
// history, while emission is deterministic and fast-changing and does not.
struct LocalMedium {
    vec3 scattering;   // sigma_s, per world unit
    float extinction;  // sigma_t, per world unit
    vec3 emission;     // sigma_a * L_e, radiance per world unit
};

// Canonical renderer-side combustion-medium constants. Keeping the fuel
// vapour coefficients here gives both camera-space integration and
// light-space transmittance the same material instead of restating it in two
// solver functions.
const float COMBUSTION_FUEL_VAPOUR_SIGMA_T = 0.0035;
const float COMBUSTION_FUEL_VAPOUR_SINGLE_SCATTER_ALBEDO = 0.10;
const int COMBUSTION_LIGHT_TRANSMITTANCE_STEPS = 8;
const float COMBUSTION_LIGHT_TRANSMITTANCE_REACH_METERS = 2.0;

LocalMedium emptyLocalMedium() {
    return LocalMedium(vec3(0.0), 0.0, vec3(0.0));
}

// Cheap deterministic phase offset so nearby fireplaces do not inhale and
// flare in lockstep. The source center is stable in absolute space and already
// bounded by the renderer's absolute-coordinate precision guard.
float localVolumeSeed(vec3 center) {
    vec3 p = fract(center * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

// Profile numbers are generated from core::FogProfile. Keep classification in
// one named predicate so local-medium behavior never grows another parallel
// table of midpoint literals.
bool isLocalProfile(float actual, float expected) {
    return abs(actual - expected) < 0.5;
}

bool isExplosionProfile(float profileKind) {
    return isLocalProfile(profileKind, FOG_VOLUME_PROFILE_EXPLOSION)
        || isLocalProfile(profileKind, FOG_VOLUME_PROFILE_EXPLOSION_OIL)
        || isLocalProfile(profileKind, FOG_VOLUME_PROFILE_EXPLOSION_NUCLEAR);
}

bool isNuclearExplosionProfile(float profileKind) {
    return isLocalProfile(profileKind, FOG_VOLUME_PROFILE_EXPLOSION_NUCLEAR);
}

bool isTransportedProfile(float profileKind) {
    return !isLocalProfile(profileKind, FOG_VOLUME_PROFILE_HOMOGENEOUS);
}

// Local structure is source-relative and independent of weather coverage.
// Smoke advects slowly in broad coherent cells; flame uses a faster, finer
// field. Returning both bands lets each profile combine them without adding
// any texture samples over the old two-sample path.
vec2 sampleLocalTurbulence(
    vec3 normalizedOffset,
    float profileKind,
    float seed,
    float timeSeconds
) {
    bool isExplosion = isExplosionProfile(profileKind);
    bool isNuclear = isNuclearExplosionProfile(profileKind);
    bool isFlame = isLocalProfile(profileKind, FOG_VOLUME_PROFILE_FLAME);
    bool isSmoke = isLocalProfile(profileKind, FOG_VOLUME_PROFILE_SMOKE);
    float baseFrequency = isNuclear ? 0.34 : (isExplosion ? 0.58 : (isFlame ? 0.72 : (isSmoke ? 0.42 : 0.31)));
    float detailFrequency = isNuclear ? 0.82 : (isExplosion ? 1.35 : (isFlame ? 1.67 : (isSmoke ? 0.96 : 0.83)));
    float baseRise = isNuclear ? 0.045 : (isExplosion ? 0.11 : (isFlame ? 0.32 : (isSmoke ? 0.075 : 0.013)));
    float detailRise = isNuclear ? 0.10 : (isExplosion ? 0.25 : (isFlame ? 0.63 : (isSmoke ? 0.14 : 0.025)));
    vec3 phase = vec3(seed, fract(seed * 1.6180339), fract(seed * 2.4142136));
    vec3 slowCoords = normalizedOffset * baseFrequency + phase
        + vec3(0.013, -baseRise, 0.009) * timeSeconds;
    vec3 detailCoords = rotateByQuaternion(
        normalizedOffset * detailFrequency,
        vec4(0.0, 0.258819, 0.0, 0.965926)
    ) + phase.zxy * 1.73 + vec3(-0.021, -detailRise, 0.017) * timeSeconds;
    float base = texture(baseDensityNoise, slowCoords).r;
    float detail = texture(detailDensityNoise, detailCoords).r;
    return clamp(vec2(base, detail), vec2(0.0), vec2(1.0));
}

// Replace the symmetric ellipsoid only for particle-derived media. Authored
// fog meshes keep their exact primitive. Smoke broadens and wanders as it
// rises; flame remains planted at the fuel and collapses into a moving tip.
float localProfileRadius(
    vec3 normalizedOffset,
    float authoredRadius,
    float profileKind,
    float seed,
    float timeSeconds,
    float explosionAge,
    float explosionAgeSeconds
) {
    if (isLocalProfile(profileKind, FOG_VOLUME_PROFILE_HOMOGENEOUS)) {
        return authoredRadius;
    }

    if (isExplosionProfile(profileKind)) {
        bool isNuclear = isNuclearExplosionProfile(profileKind);
        // Expansion is a physical-time event, not a fraction of the authored
        // cooling lifetime. A long-lived 8 s effect must still become a full
        // fireball in roughly 0.35 s rather than remaining a bead at age 0.02.
        float expansionTime = isNuclear
            ? EXPLOSION_EXPANSION_TIME_SECONDS * 1.8
            : EXPLOSION_EXPANSION_TIME_SECONDS;
        float expansion = 1.0 - exp(
            -explosionAgeSeconds / max(expansionTime, 0.01)
        );
        float radius = mix(0.10, 0.96, expansion);
        float phase = seed * 2.0 * PI;
        vec2 wobble = mix(0.015, 0.12, explosionAge) * vec2(
            sin(phase + timeSeconds * 1.7),
            cos(phase * 1.37 + timeSeconds * 1.3)
        );
        float buoyantLift = smoothstep(0.35, 2.2, explosionAgeSeconds) * 0.18;
        vec3 displaced = normalizedOffset - vec3(wobble.x, buoyantLift, wobble.y);
        float fireball = length(displaced) / max(radius, 0.04);
        if (!isNuclear) {
            return fireball;
        }

        // Once the flash has lifted, replace the spherical boundary with a
        // cap-over-stem union. Both pieces live inside the authored source
        // bound; transport then carries that shaped mass outward and upward.
        float mushroomMature = smoothstep(0.30, 1.25, explosionAgeSeconds);
        float capCenter = mix(0.08, 0.42, mushroomMature);
        float capThickness = mix(0.30, 0.38, mushroomMature);
        float capRadius = mix(0.48, 0.88, mushroomMature);
        float capRadial = length(normalizedOffset.xz - wobble) / capRadius;
        float cap = max(
            abs(normalizedOffset.y - capCenter) / capThickness,
            capRadial
        );
        float stemBottom = mix(-0.40, -0.78, mushroomMature);
        float stemTop = mix(0.18, 0.42, mushroomMature);
        float stemCenter = (stemBottom + stemTop) * 0.5;
        float stemHalfHeight = (stemTop - stemBottom) * 0.5;
        float stemRadius = mix(0.27, 0.18, mushroomMature);
        float stem = max(
            abs(normalizedOffset.y - stemCenter) / max(stemHalfHeight, 0.05),
            length(normalizedOffset.xz - wobble * 0.45) / stemRadius
        );
        // `cap` and `stem` are distance-like masks: values below one are
        // inside. Taking their minimum therefore forms the volumetric union
        // (the mushroom silhouette), rather than a fragile intersection.
        return mix(fireball, min(cap, stem), mushroomMature);
    }

    float height = clamp(normalizedOffset.y * 0.5 + 0.5, 0.0, 1.0);
    float phase = seed * 2.0 * PI;
    vec2 centerline;
    float radius;
    if (isLocalProfile(profileKind, FOG_VOLUME_PROFILE_FLAME)) {
        float swayAmplitude = mix(0.015, 0.15, height);
        centerline = swayAmplitude * vec2(
            sin(phase + height * 5.2 + timeSeconds * 1.7),
            cos(phase * 1.37 + height * 4.1 + timeSeconds * 1.3)
        );
        radius = mix(0.92, 0.18, pow(height, 1.18));
    } else {
        float driftAmplitude = mix(0.01, 0.19, height);
        centerline = driftAmplitude * vec2(
            sin(phase + height * 3.1 + timeSeconds * 0.24),
            cos(phase * 1.21 + height * 2.7 + timeSeconds * 0.19)
        );
        radius = mix(0.46, 1.0, smoothstep(0.0, 1.0, height));
    }

    float radial = length(normalizedOffset.xz - centerline) / max(radius, 0.05);
    return max(abs(normalizedOffset.y), radial);
}

float localDensityProfile(
    vec3 normalizedOffset,
    float profileRadius,
    float edge,
    float profileKind,
    vec2 turbulence,
    float seed,
    float timeSeconds,
    float explosionAge,
    float explosionAgeSeconds
) {
    float boundary = 1.0 - smoothstep(1.0 - edge, 1.0, profileRadius);
    if (isLocalProfile(profileKind, FOG_VOLUME_PROFILE_HOMOGENEOUS)) {
        float genericNoise = turbulence.x * 0.72 + turbulence.y * 0.28;
        return boundary * mix(0.55, 1.15, genericNoise);
    }

    if (isExplosionProfile(profileKind)) {
        float core = 1.0 - smoothstep(0.10, 0.94, profileRadius);
        bool isNuclear = isNuclearExplosionProfile(profileKind);
        float shellCenter = mix(0.52, 0.76, smoothstep(0.0, 0.72, explosionAge));
        float shell = 1.0 - smoothstep(0.10, 0.27, abs(profileRadius - shellCenter));
        float smokeTransition = smoothstep(0.20, 0.72, explosionAge);
        float clumps = mix(
            0.34,
            1.48,
            smoothstep(0.20, 0.82, turbulence.x * 0.64 + turbulence.y * 0.36)
        );
        // Keep a visible, hot perimeter during the first part of the blast.
        // The shell becomes the cooled aerosol body later, but a very small
        // early coefficient made the explosion read as a bright pinprick
        // surrounded by opacity that did not emit.
        float evolvingBody = mix(core + shell * 0.40, shell + core * 0.16, smokeTransition);
        float nuclearCap = isNuclear
            // Use physical seconds here as well as in the geometry path. A
            // nuclear source can have an 8 s authored lifetime, but its cap
            // should begin forming around one second, not at 24% of that
            // lifetime (which would delay the mushroom until 1.9 s).
            ? smoothstep(0.35, 1.25, explosionAgeSeconds)
                * (1.0 - smoothstep(4.8, 7.2, explosionAgeSeconds))
            : 0.0;
        float capBody = max(evolvingBody, nuclearCap * 0.75);
        float dissipate = isNuclear
            ? 1.0 - smoothstep(0.94, 1.0, explosionAge)
            : 1.0 - smoothstep(0.80, 1.0, explosionAge);
        return boundary * capBody * clumps * dissipate;
    }

    float height = clamp(normalizedOffset.y * 0.5 + 0.5, 0.0, 1.0);
    float rootFade = smoothstep(-1.0, -0.78, normalizedOffset.y);
    if (isLocalProfile(profileKind, FOG_VOLUME_PROFILE_SMOKE)) {
        float billowNoise = turbulence.x * 0.76 + turbulence.y * 0.24;
        float occupied = smoothstep(0.24, 0.78, billowNoise);
        float rolls = 0.5 + 0.5 * sin(
            height * 13.0 + seed * 2.0 * PI + timeSeconds * 0.48
                + turbulence.y * 2.4
        );
        return boundary * rootFade
            * mix(0.32, 1.38, occupied)
            * mix(0.82, 1.16, rolls);
    }

    float lickNoise = turbulence.x * 0.43 + turbulence.y * 0.57;
    float split = 0.5 + 0.5 * sin(
        atan(normalizedOffset.z, normalizedOffset.x) * 3.0
            + normalizedOffset.y * 7.0
            - timeSeconds * 2.1
            + seed * 2.0 * PI
    );
    float threshold = mix(0.20, 0.58, height);
    float licks = smoothstep(threshold - 0.18, threshold + 0.24, lickNoise + split * 0.13);
    float hotCore = 1.0 - smoothstep(0.0, 0.42, profileRadius);
    return boundary * rootFade * (mix(0.24, 1.42, licks) + hotCore * 0.28);
}

// Approximate blackbody chromaticity from Planck's law at representative
// linear-sRGB wavelengths. Energy is normalized to unit Rec. 709 luminance;
// the physically dominant T^4 radiance scaling is applied separately below.
vec3 blackbodyChromaticity(float kelvin) {
    float temperature = clamp(kelvin, 700.0, 12000.0);
    vec3 wavelengthNm = vec3(610.0, 550.0, 460.0);
    const float referenceNm = 610.0;
    const float c2NmK = 1.438776877e7;
    float referenceDenominator = exp(clamp(c2NmK / (referenceNm * temperature), 0.0, 80.0)) - 1.0;
    vec3 denominator = exp(clamp(
        vec3(c2NmK) / (wavelengthNm * temperature),
        vec3(0.0),
        vec3(80.0)
    )) - vec3(1.0);
    vec3 spectral = pow(vec3(referenceNm) / wavelengthNm, vec3(5.0))
        * referenceDenominator / max(denominator, vec3(1.0e-6));
    return spectral / max(dot(spectral, LUMA_REC709), 1.0e-4);
}

// Visible-band blackbody-radiance ratio, evaluated at the photopic response
// peak (555 nm). The CPU canonical source uses a full CIE integration; this
// one-wavelength ratio is the inexpensive per-froxel approximation to the
// same Planck-law magnitude trend. Calibration is transported separately, so
// the ratio is exactly 1 at the shared 1850 K flame reference and preserves
// each source's authored/canonical HDR exposure.
float blackbodyVisibleRadianceRatio(float kelvin, float referenceKelvin) {
    const float wavelengthNm = 555.0;
    const float c2NmK = 1.438776877e7;
    float temperature = clamp(kelvin, 700.0, 12000.0);
    float referenceTemperature = clamp(referenceKelvin, 700.0, 12000.0);
    float numerator = exp(clamp(
        c2NmK / (wavelengthNm * referenceTemperature),
        0.0,
        80.0
    )) - 1.0;
    float denominator = exp(clamp(
        c2NmK / (wavelengthNm * temperature),
        0.0,
        80.0
    )) - 1.0;
    return clamp(numerator / max(denominator, 1.0e-6), 0.0, 4096.0);
}

// Resolve the one camera-centred cluster containing a world-space sample.
// Keeping this lookup and the primitive-shape evaluation shared prevents the
// analytic homogeneous path and the transported combustion source path from
// growing subtly different interpretations of the same canonical volume.
//
// #2242 (REN-D16-04) — this `fogVolumeCount == 0u` check is not a fragile
// lone guard against a stale cluster buffer surviving a cell transition.
// There is no persistent cluster state to go stale: `fogVolumeCount`
// (`VolumetricsPipeline::dispatch`, volumetrics.rs) is rewritten every
// single frame, either explicitly zeroed when this frame's fog-volume list
// is empty, or set fresh by `build_fog_volume_clusters` — which itself
// resets EVERY cluster entry's `count` to 0 before repopulating from this
// frame's volumes, every call, with no incremental/partial update (#3133:
// `offset` is a permanent per-slot invariant seeded once and no longer
// re-touched per frame, but `count` still is). The `fog_cluster_buffers`/
// `fog_cluster_index_buffers` GPU writes are skipped as an optimisation
// exactly when `fogVolumeCount` is also unconditionally zeroed, so this
// early-out always gates the stale/skipped-write case correctly. A cell
// transition simply means next frame's `collect_fog_volumes`
// (byroredux/src/render/fog_volumes.rs) returns a different `Vec` from live
// ECS state — the whole pipeline is a full per-frame rebuild, not an
// incremental one.
bool localFogCluster(vec3 worldPos, out FogClusterEntry cluster) {
    if (fogVolumeCount == 0u || params.local_volume_grid.w <= 0.0) {
        return false;
    }

    vec3 gridCoord = (worldPos - params.local_volume_grid.xyz)
        * params.local_volume_grid.w;
    if (any(lessThan(gridCoord, vec3(0.0)))
            || any(greaterThanEqual(gridCoord, vec3(float(FOG_VOLUME_CLUSTER_DIM))))) {
        return false;
    }
    uvec3 cell = min(uvec3(gridCoord), uvec3(FOG_VOLUME_CLUSTER_DIM - 1u));
    uint clusterIndex = cell.x
        + cell.y * FOG_VOLUME_CLUSTER_DIM
        + cell.z * FOG_VOLUME_CLUSTER_DIM * FOG_VOLUME_CLUSTER_DIM;
    cluster = fogClusters[clusterIndex];
    return true;
}

bool evaluateLocalFogVolume(
    GpuFogVolume volume,
    vec3 worldPos,
    out vec3 normalizedOffset,
    out vec3 localOffset,
    out float profileKind,
    out float densityProfile,
    out vec2 localTurbulence
) {
    vec3 extents = max(volume.half_extents_extinction.xyz, vec3(1.0e-4));
    localOffset = rotateByQuaternion(
        worldPos - volume.center_shape.xyz,
        volume.inverse_rotation
    );
    normalizedOffset = localOffset / extents;
    float shape = volume.center_shape.w;
    float normalizedRadius;
    if (shape > 1.5) {
        normalizedRadius = max(
            abs(normalizedOffset.x),
            max(abs(normalizedOffset.y), abs(normalizedOffset.z))
        );
    } else if (shape < 0.5) {
        normalizedRadius = length(localOffset) / extents.x;
    } else {
        normalizedRadius = length(normalizedOffset);
    }
    profileKind = clamp(
        volume.profile_params.x,
        FOG_VOLUME_PROFILE_HOMOGENEOUS,
        FOG_VOLUME_PROFILE_EXPLOSION_NUCLEAR
    );
    float timeSeconds = params.temporal_params.z;
    float seed = localVolumeSeed(volume.center_shape.xyz);
    float explosionAge = clamp(volume.profile_params.y, 0.0, 1.0);
    float explosionAgeSeconds = explosionAge * max(volume.profile_params.z, 0.0);
    float profileRadius = localProfileRadius(
        normalizedOffset,
        normalizedRadius,
        profileKind,
        seed,
        timeSeconds,
        explosionAge,
        explosionAgeSeconds
    );
    if (profileRadius >= 1.0) {
        return false;
    }

    float edge = clamp(volume.albedo_edge.w, 1.0e-3, 1.0);
    localTurbulence = sampleLocalTurbulence(
        normalizedOffset,
        profileKind,
        seed,
        timeSeconds
    );
    densityProfile = localDensityProfile(
        normalizedOffset,
        profileRadius,
        edge,
        profileKind,
        localTurbulence,
        seed,
        timeSeconds,
        explosionAge,
        explosionAgeSeconds
    );
    return densityProfile > 1.0e-6;
}

// Returns only directly-authored homogeneous media. Smoke, flame, and
// explosions enter the transported thermochemical field below; rendering
// their old analytic body as well would double-count extinction and pin the
// plume to its emitter instead of allowing advection to move it.
LocalMedium sampleLocalMedium(vec3 worldPos) {
    LocalMedium medium = emptyLocalMedium();
    FogClusterEntry cluster;
    if (!localFogCluster(worldPos, cluster)) {
        return medium;
    }
    uint primitiveCount = min(cluster.count, MAX_FOG_VOLUMES_PER_CLUSTER);

    for (uint i = 0u; i < primitiveCount; ++i) {
        uint volumeIndex = fogClusterIndices[cluster.offset + i];
        if (volumeIndex >= fogVolumeCount) {
            continue;
        }
        GpuFogVolume volume = fogVolumes[volumeIndex];
        vec3 normalizedOffset;
        vec3 localOffset;
        float profileKind;
        float densityProfile;
        vec2 localTurbulence;
        if (!evaluateLocalFogVolume(
                volume,
                worldPos,
                normalizedOffset,
                localOffset,
                profileKind,
                densityProfile,
                localTurbulence)
                || isTransportedProfile(profileKind)) {
            continue;
        }
        float sigmaT = max(volume.half_extents_extinction.w, 0.0) * densityProfile;
        vec3 albedo = clamp(volume.albedo_edge.rgb, vec3(0.0), vec3(1.0));
        vec3 emissiveRadiance = max(volume.emission_temperature.rgb, vec3(0.0));
        medium.extinction += sigmaT;
        medium.scattering += sigmaT * albedo;

        // Emission source term of the radiative transfer equation:
        //   dL/ds |_emission = sigma_a * L_e,   sigma_a = sigma_t * (1 - albedo)
        //
        // Per channel, because soot's absorption is spectrally selective and
        // because `albedo` is already an RGB triple here. Multiplying by the
        // locally evaluated sigma_a (not by a constant) is what gives a flame
        // visible internal structure: the same procedural density field that
        // shapes its silhouette also shapes where it glows brightest.
        //
        // This is why fire needs no separate render path. `integrate` already
        // treats this buffer's rgb as "radiance added per unit length" and
        // multiplies by slab thickness and accumulated transmittance, which
        // is exactly the emission integral. Fire composites, denoises, and
        // reprojects through the machinery fog already uses.
        medium.emission += sigmaT * (vec3(1.0) - albedo) * emissiveRadiance;
    }
    return medium;
}

// The transported field is intentionally deterministic at each froxel centre,
// but a persistent flame's source boundary is often only a few froxels wide.
// Re-evaluate that canonical source profile at the jittered lighting sample and
// use the centre/sample density ratio as an unbiased sub-froxel coverage hint.
// This shapes only the planted flame boundary; advected chemistry outside it
// remains entirely owned by transport and cannot snap back to the emitter.
float flameSourceSampleRatio(vec3 fieldWorldPos, vec3 sampleWorldPos) {
    FogClusterEntry cluster;
    if (!localFogCluster(fieldWorldPos, cluster)) {
        return 1.0;
    }

    float centerDensitySum = 0.0;
    float sampleDensitySum = 0.0;
    uint primitiveCount = min(cluster.count, MAX_FOG_VOLUMES_PER_CLUSTER);
    for (uint i = 0u; i < primitiveCount; ++i) {
        uint volumeIndex = fogClusterIndices[cluster.offset + i];
        if (volumeIndex >= fogVolumeCount) {
            continue;
        }
        GpuFogVolume volume = fogVolumes[volumeIndex];
        float profileKind = clamp(
            volume.profile_params.x,
            FOG_VOLUME_PROFILE_HOMOGENEOUS,
            FOG_VOLUME_PROFILE_EXPLOSION_NUCLEAR
        );
        if (!isLocalProfile(profileKind, FOG_VOLUME_PROFILE_FLAME)) {
            continue;
        }

        vec3 normalizedOffset;
        vec3 localOffset;
        float evaluatedProfile;
        float centerDensity;
        vec2 localTurbulence;
        if (!evaluateLocalFogVolume(
                volume,
                fieldWorldPos,
                normalizedOffset,
                localOffset,
                evaluatedProfile,
                centerDensity,
                localTurbulence)) {
            continue;
        }
        centerDensitySum += centerDensity;

        float sampleDensity;
        if (evaluateLocalFogVolume(
                volume,
                sampleWorldPos,
                normalizedOffset,
                localOffset,
                evaluatedProfile,
                sampleDensity,
                localTurbulence)) {
            sampleDensitySum += sampleDensity;
        }
    }
    if (centerDensitySum <= 1.0e-6) {
        return 1.0;
    }
    return clamp(sampleDensitySum / centerDensitySum, 0.0, 1.5);
}

// Return the [0,1] interval where a normalized line segment lies inside a
// unit sphere. Sphere and ellipsoid FogBounds both become a unit sphere after
// division by their authored half extents.
bool intersectUnitSphereSegment(vec3 start, vec3 end, out vec2 interval) {
    vec3 direction = end - start;
    float a = dot(direction, direction);
    if (a <= 1.0e-10) {
        interval = vec2(0.0, 1.0);
        return dot(start, start) <= 1.0;
    }
    float b = dot(start, direction);
    float c = dot(start, start) - 1.0;
    float discriminant = b * b - a * c;
    if (discriminant < 0.0) {
        return false;
    }
    float root = sqrt(max(discriminant, 0.0));
    interval = vec2((-b - root) / a, (-b + root) / a);
    interval = clamp(interval, vec2(0.0), vec2(1.0));
    return interval.y > interval.x;
}

// Slab intersection against a normalized [-1,1]^3 box.
bool intersectUnitBoxSegment(vec3 start, vec3 end, out vec2 interval) {
    vec3 direction = end - start;
    float entry = 0.0;
    float exit = 1.0;
    for (int axis = 0; axis < 3; ++axis) {
        if (abs(direction[axis]) <= 1.0e-8) {
            if (abs(start[axis]) > 1.0) {
                return false;
            }
            continue;
        }
        vec2 crossings = vec2(
            (-1.0 - start[axis]) / direction[axis],
            (1.0 - start[axis]) / direction[axis]
        );
        float axisEntry = min(crossings.x, crossings.y);
        float axisExit = max(crossings.x, crossings.y);
        entry = max(entry, axisEntry);
        exit = min(exit, axisExit);
        if (exit <= entry) {
            return false;
        }
    }
    interval = clamp(vec2(entry, exit), vec2(0.0), vec2(1.0));
    return interval.y > interval.x;
}

// Conservative gather for an emitter that may be thinner than one froxel
// depth slab. Point-sampling only the slab centre deterministically loses a
// Bethesda-scale torch/explosion whenever it falls between two centres. We
// intersect the entire camera-ray segment with the canonical primitive,
// evaluate three deterministic interior points, and multiply by the occupied
// segment fraction. The resulting coefficient preserves optical depth instead
// of inflating a sub-slab source to fill the whole froxel.
bool evaluateCombustionSource(
    GpuFogVolume volume,
    vec3 segmentStart,
    vec3 segmentEnd,
    out vec3 sourceWorldPos,
    out vec3 normalizedOffset,
    out float profileKind,
    out float densityProfile,
    out float stateProfile,
    out vec2 turbulence
) {
    profileKind = clamp(
        volume.profile_params.x,
        FOG_VOLUME_PROFILE_HOMOGENEOUS,
        FOG_VOLUME_PROFILE_EXPLOSION_NUCLEAR
    );
    if (!isTransportedProfile(profileKind)) {
        return false;
    }

    vec3 extents = max(volume.half_extents_extinction.xyz, vec3(1.0e-4));
    vec3 localStart = rotateByQuaternion(
        segmentStart - volume.center_shape.xyz,
        volume.inverse_rotation
    ) / extents;
    vec3 localEnd = rotateByQuaternion(
        segmentEnd - volume.center_shape.xyz,
        volume.inverse_rotation
    ) / extents;
    vec2 interval;
    bool intersects = volume.center_shape.w > 1.5
        ? intersectUnitBoxSegment(localStart, localEnd, interval)
        : intersectUnitSphereSegment(localStart, localEnd, interval);
    if (!intersects) {
        return false;
    }

    float segmentCoverage = interval.y - interval.x;
    densityProfile = 0.0;
    stateProfile = 0.0;
    sourceWorldPos = mix(segmentStart, segmentEnd, 0.5 * (interval.x + interval.y));
    normalizedOffset = vec3(0.0);
    turbulence = vec2(0.5);
    for (int sampleIndex = 0; sampleIndex < 3; ++sampleIndex) {
        float samplePhase = (float(sampleIndex) + 0.5) / 3.0;
        vec3 candidateWorldPos = mix(
            segmentStart,
            segmentEnd,
            mix(interval.x, interval.y, samplePhase)
        );
        vec3 candidateNormalizedOffset;
        vec3 candidateLocalOffset;
        float candidateProfile;
        float candidateDensity;
        vec2 candidateTurbulence;
        if (evaluateLocalFogVolume(
                volume,
                candidateWorldPos,
                candidateNormalizedOffset,
                candidateLocalOffset,
                candidateProfile,
                candidateDensity,
                candidateTurbulence)
                && candidateDensity > densityProfile) {
            densityProfile = candidateDensity;
            stateProfile = candidateDensity;
            sourceWorldPos = candidateWorldPos;
            normalizedOffset = candidateNormalizedOffset;
            turbulence = candidateTurbulence;
        }
    }
    // Extensive quantities (fuel mass and optical extinction) occupy only
    // part of this depth slab, so their volume average carries coverage.
    // Intensive source state (temperature, radiance calibration, velocity)
    // must retain the strongest occupied sample. Scaling both would apply
    // coverage twice in `combustionMedium` (`sigma_t * L_e`) and can push a
    // perfectly hot sub-froxel flame below ignition merely because the
    // transport grid is coarse.
    densityProfile *= segmentCoverage;
    return densityProfile > 1.0e-7;
}

void applyCombustionSources(
    vec3 worldPos,
    vec3 segmentStart,
    vec3 segmentEnd,
    inout vec4 chemistry,
    inout vec4 dynamics,
    inout vec4 optical,
    float dt
) {
    FogClusterEntry cluster;
    if (!localFogCluster(worldPos, cluster)) {
        return;
    }
    uint primitiveCount = min(cluster.count, MAX_FOG_VOLUMES_PER_CLUSTER);
    for (uint i = 0u; i < primitiveCount; ++i) {
        uint volumeIndex = fogClusterIndices[cluster.offset + i];
        if (volumeIndex >= fogVolumeCount) {
            continue;
        }
        GpuFogVolume volume = fogVolumes[volumeIndex];
        vec3 sourceWorldPos;
        vec3 normalizedOffset;
        float profileKind;
        float densityProfile;
        float stateProfile;
        vec2 turbulence;
        if (!evaluateCombustionSource(
                volume,
                segmentStart,
                segmentEnd,
                sourceWorldPos,
                normalizedOffset,
                profileKind,
                densityProfile,
                stateProfile,
                turbulence)) {
            continue;
        }

        float radialSource = 1.0 - smoothstep(0.28, 0.92, length(normalizedOffset.xz));
        float normalizedHeight = normalizedOffset.y * 0.5 + 0.5;
        bool nuclearExplosion = isNuclearExplosionProfile(profileKind);
        float basalSource = isLocalProfile(profileKind, FOG_VOLUME_PROFILE_FLAME)
            ? 1.0 - smoothstep(
                0.0,
                FLAME_FUEL_BOUNDARY_HEIGHT_FRACTION,
                normalizedHeight
            )
            : (nuclearExplosion
                ? 1.0
                : 1.0 - smoothstep(-0.72, 0.10, normalizedOffset.y));
        float sourceMask = densityProfile * radialSource * basalSource;
        float sourceStateMask = stateProfile * radialSource * basalSource;
        float authoredSigmaT = max(volume.half_extents_extinction.w, 0.0);
        vec3 sourceAlbedo = clamp(volume.albedo_edge.rgb, vec3(0.0), vec3(1.0));

        if (isLocalProfile(profileKind, FOG_VOLUME_PROFILE_SMOKE)) {
            // Passive smoke supplies aerosol and a mild warm/upward exhaust,
            // but no fuel. `max` models a continuously emitting boundary
            // without making density depend on frame rate.
            float sourceSigmaT = authoredSigmaT * sourceMask;
            chemistry.z = max(chemistry.z, sourceSigmaT);
            optical.rgb = max(optical.rgb, sourceSigmaT * sourceAlbedo);
            chemistry.y = max(
                chemistry.y,
                mix(AMBIENT_TEMPERATURE_K, 430.0, sourceStateMask)
            );
            dynamics.y = max(
                dynamics.y,
                sourceStateMask * 0.42 * WORLD_UNITS_PER_METER
            );
            continue;
        }

        if (isLocalProfile(profileKind, FOG_VOLUME_PROFILE_FLAME)) {
            // A persistent flame has a compact replenished fuel inlet and a
            // larger luminous reaction zone. The transported solver, not the
            // authored bound, determines the tip, downstream plume, and soot
            // left after combustion.
            float reactionZone = 1.0 - smoothstep(
                FLAME_REACTION_ZONE_FADE_START_FRACTION,
                FLAME_REACTION_ZONE_HEIGHT_FRACTION,
                normalizedHeight
            );
            float reactionMask = densityProfile * radialSource * reactionZone;
            float reactionStateMask = stateProfile * radialSource * reactionZone;
            float sourceTemperature = clamp(
                max(volume.emission_temperature.w, 1650.0),
                IGNITION_TEMPERATURE_K,
                MAX_COMBUSTION_TEMPERATURE_K
            );
            chemistry.x = max(chemistry.x, sourceMask * 0.82);
            chemistry.y = max(
                chemistry.y,
                mix(AMBIENT_TEMPERATURE_K, sourceTemperature, reactionStateMask)
            );
            float sourceSigmaT = authoredSigmaT * reactionMask * 0.16;
            chemistry.z = max(chemistry.z, sourceSigmaT);
            optical.rgb = max(optical.rgb, sourceSigmaT * sourceAlbedo);
            float sourceRadianceLuma = max(
                dot(volume.emission_temperature.rgb, LUMA_REC709),
                0.0
            );
            float sourceVisibleRatio = blackbodyVisibleRadianceRatio(
                sourceTemperature,
                1850.0
            );
            chemistry.w = max(
                chemistry.w,
                reactionStateMask * sourceRadianceLuma / max(sourceVisibleRatio, 1.0e-4)
            );
            dynamics.y = max(
                dynamics.y,
                reactionStateMask * mix(1.12, 1.48, turbulence.x)
                    * WORLD_UNITS_PER_METER
            );
            vec2 lateralTarget = (turbulence * 2.0 - 1.0)
                * FLAME_SOURCE_LATERAL_SPEED_MPS
                * WORLD_UNITS_PER_METER;
            float velocityResponse = 1.0 - exp(
                -FLAME_SOURCE_VELOCITY_RESPONSE_PER_SECOND
                    * reactionStateMask
                    * dt
            );
            dynamics.xz = mix(dynamics.xz, lateralTarget, velocityResponse);
            continue;
        }

        // Explosion: a finite radial momentum/heat/fuel impulse. The authored
        // primitive is the *swept bound* of the legacy particle effect, not a
        // continuously burning spherical volume. Re-injecting its whole
        // age-expanded density body every frame pins a bright ball to the
        // emitter and overwhelms advection. Warm history therefore receives
        // only a compact, early core impulse; after that the transported field
        // owns expansion, cooling, soot, and buoyancy.
        //
        // A cold history (camera cut/resize) is different: seed the canonical
        // density at its current age once so an in-progress blast does not
        // disappear merely because storage was reset.
        float age = clamp(volume.profile_params.y, 0.0, 1.0);
        float lifetime = max(volume.profile_params.z, 0.12);
        float ageSeconds = age * lifetime;
        float ignitionEnvelope = nuclearExplosion
            ? 1.0 - smoothstep(0.20, 1.0, ageSeconds)
            : 1.0 - smoothstep(0.12, 0.75, ageSeconds);
        float smokeEnvelope = nuclearExplosion
            ? smoothstep(0.35, 1.8, ageSeconds)
                * (1.0 - smoothstep(0.96, 1.0, age))
            : smoothstep(0.35, 1.25, ageSeconds)
                * (1.0 - smoothstep(0.88, 1.0, age));
        bool coldHistory = params.prev_camera_pos.w <= 0.5;
        float impulseEnvelope = 1.0 - smoothstep(
            EXPLOSION_IMPULSE_DURATION_SECONDS * 0.35,
            EXPLOSION_IMPULSE_DURATION_SECONDS,
            ageSeconds
        );
        float coreRadius = length(normalizedOffset);
        float compactCore = 1.0 - smoothstep(0.12, 0.36, coreRadius);
        // A one-froxel fireball needs a warm shell as well as its compact
        // centre. Without this, the authored explosion's visible shell is
        // seeded only as cooled smoke and the normal composite reduces it to
        // a tiny ember even though the volume debug view shows its opacity.
        float shellCenter = mix(0.42, 0.62, age);
        float hotShell = 1.0 - smoothstep(
            0.16,
            0.44,
            abs(coreRadius - shellCenter)
        );
        float ignitionCoverage = max(compactCore, hotShell * 0.55);
        float ignitionMask = densityProfile * (
            coldHistory
                ? ignitionEnvelope
                : ignitionCoverage * impulseEnvelope
        );
        float ignitionStateMask = stateProfile * (
            coldHistory
                ? ignitionEnvelope
                : ignitionCoverage * impulseEnvelope
        );
        // Seed the finite event's cooling shell, not only its compact hot
        // core. This is still a one-shot source term (the envelope closes
        // before the emitter expires), but it gives the transported aerosol
        // enough mass to survive the fireball and rise as visible smoke.
        float smokeSeedMask = coldHistory
            ? densityProfile * smokeEnvelope
            : densityProfile * smokeEnvelope * 0.38;
        float sourceTemperature = clamp(
            max(volume.emission_temperature.w, nuclearExplosion ? 3800.0 : 2300.0),
            IGNITION_TEMPERATURE_K,
            MAX_COMBUSTION_TEMPERATURE_K
        );
        chemistry.x = max(
            chemistry.x,
            ignitionMask * (nuclearExplosion ? 1.0 : 0.72)
        );
        chemistry.y = max(
            chemistry.y,
            mix(AMBIENT_TEMPERATURE_K, sourceTemperature, ignitionStateMask)
        );
        chemistry.y = max(
            chemistry.y,
            mix(
                AMBIENT_TEMPERATURE_K,
                COMBUSTION_COOLED_AEROSOL_SOURCE_TEMPERATURE_K,
                smokeSeedMask
            )
        );
        dynamics.y = max(
            dynamics.y,
            smokeSeedMask
                * COMBUSTION_TURBULENCE_COARSE_RISE_SPEED_MPS
                * (nuclearExplosion ? NUCLEAR_EXPLOSION_BUOYANCY_SCALE : 1.0)
                * WORLD_UNITS_PER_METER
        );
        float sourceSigmaT = authoredSigmaT
            * (ignitionMask * 0.10
                + smokeSeedMask * COMBUSTION_EXPLOSION_SMOKE_EXTINCTION_SCALE
                    * (nuclearExplosion ? NUCLEAR_EXPLOSION_SMOKE_MASS_SCALE : 1.0));
        chemistry.z = max(chemistry.z, sourceSigmaT);
        optical.rgb = max(optical.rgb, sourceSigmaT * sourceAlbedo);
        float sourceRadianceLuma = max(
            dot(volume.emission_temperature.rgb, LUMA_REC709),
            0.0
        );
        float sourceVisibleRatio = blackbodyVisibleRadianceRatio(
            sourceTemperature,
            1850.0
        );
        chemistry.w = max(
            chemistry.w,
            ignitionStateMask * sourceRadianceLuma / max(sourceVisibleRatio, 1.0e-4)
        );
        vec3 radialDirection = sourceWorldPos - volume.center_shape.xyz;
        float radialLength = length(radialDirection);
        radialDirection = radialLength > 1.0e-4
            ? radialDirection / radialLength
            : vec3(0.0, 1.0, 0.0);
        float radius = max(
            volume.half_extents_extinction.x,
            max(volume.half_extents_extinction.y, volume.half_extents_extinction.z)
        );
        float expansionSpeed = min(
            radius / EXPLOSION_EXPANSION_TIME_SECONDS
                * (nuclearExplosion ? NUCLEAR_EXPLOSION_EXPANSION_SCALE : 1.0),
            MAX_COMBUSTION_SPEED_MPS * WORLD_UNITS_PER_METER
        );
        float impulseScale = !coldHistory
            ? dt * 7.0
            : 0.45;
        float radialImpulseMask = coldHistory
            ? stateProfile * ignitionEnvelope
            : stateProfile * (nuclearExplosion ? ignitionCoverage : compactCore)
                * impulseEnvelope;
        dynamics.xyz += radialDirection * expansionSpeed
            * radialImpulseMask * impulseScale;
        float expansionSpeedMps = expansionSpeed / WORLD_UNITS_PER_METER;
        float specificOverpressure = 0.5 * expansionSpeedMps * expansionSpeedMps;
        dynamics.w = max(
            dynamics.w,
            specificOverpressure * radialImpulseMask
        );
    }
}

// Simplified point/spot attenuation — mirrors `pointSpotAtten`'s
// default-tier curve (`include/lighting.glsl`) but self-contained:
// this compute shader has none of that function's dependencies
// (`dofParams.z` knee-frac override, `dbgFlags` legacy A/B branch)
// bound, and doesn't need them for an ambient-style fog glow.
// Both arms recover the authored range from `R` (the CULL radius) through
// the shared LEGACY_LIGHT_CULL_RANGE_MULTIPLIER, and both fold in
// `sourceRadius` the way `Emitter::distance_attenuation` does — see the
// same two lines in `pointSpotAtten`.
float froxelLightAtten(
    float dist, float R, float shape, float sourceRadius, float encodedModel
) {
    uint model = uint(clamp(floor(encodedModel + 0.5),
        float(ATTENUATION_MODEL_LEGACY_SOFT_RANGE),
        float(ATTENUATION_MODEL_INVERSE_SQUARE)));
    if (model == ATTENUATION_MODEL_INVERSE_SQUARE) {
        float distanceMeters = dist / WORLD_UNITS_PER_METER;
        float sourceMeters = max(sourceRadius / WORLD_UNITS_PER_METER, 0.001);
        float inverseSquare = 1.0 / max(
            distanceMeters * distanceMeters,
            sourceMeters * sourceMeters
        );
        float authoredRange = max(R / LEGACY_LIGHT_CULL_RANGE_MULTIPLIER, sourceRadius);
        float cullWindow = 1.0 - smoothstep(authoredRange, max(R, authoredRange + 1.0), dist);
        return inverseSquare * cullWindow;
    }
    float knee = max(max(R / LEGACY_LIGHT_CULL_RANGE_MULTIPLIER, sourceRadius), 1.0);
    float dn = dist / knee;
    float phys = 1.0 / (1.0 + shape * dn * dn);
    float wcull = 1.0 - smoothstep(knee, max(R, knee + 1.0), dist);
    return phys * wcull;
}

// Curl of a periodic vector potential. The field is divergence-free by
// construction, so domain warping swirls without the "shower door" look of a
// uniform texture scroll. Inputs and amplitudes are physical metres.
vec3 curlField(vec3 p) {
    return vec3(
        -sin(p.y) - cos(p.z),
        -sin(p.z) - cos(p.x),
        -sin(p.x) - cos(p.y)
    ) * 0.5;
}

vec3 rotateY(vec3 p, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return vec3(c * p.x - s * p.z, p.y, s * p.x + c * p.z);
}

vec3 warpFogDomain(vec3 worldMetres, float timeSeconds) {
    vec3 slow = curlField(worldMetres * 0.045 + vec3(0.07, 0.01, -0.04) * timeSeconds);
    vec3 layerPos = rotateY(worldMetres, 0.5235987756);
    vec3 fast = rotateY(
        curlField(layerPos * 0.11 + vec3(-0.03, 0.05, 0.08) * timeSeconds),
        -0.5235987756
    );
    return worldMetres + slow * 5.0 + fast * 2.0
        - vec3(0.15, 0.0, 0.05) * timeSeconds;
}

// Nubis-style coverage remap followed by high-frequency edge erosion.
// Coverage comes from authored WTHR classification and is interpolated by the
// weather transition system before it reaches this shader.
float sampledDensity(vec3 metres, float baseScale, float detailScale) {
    float coverage = clamp(params.temporal_params.w, 0.01, 1.0);
    float base = texture(baseDensityNoise, metres / baseScale).r;
    vec3 detailCoords = rotateY(metres, 0.3769911184) / detailScale;
    float detail = texture(detailDensityNoise, detailCoords).r;
    float threshold = 1.0 - coverage;
    float softness = mix(0.045, 0.13, coverage);
    float occupied = smoothstep(
        threshold - softness,
        threshold + softness,
        base
    );
    float boundary = 4.0 * occupied * (1.0 - occupied);
    float erosion = (1.0 - detail) * boundary * mix(0.42, 0.18, coverage);
    return clamp(occupied - erosion, 0.0, 1.0);
}

float proceduralDensityScale(vec3 worldPos, float refHeight) {
    float heightAbove = max(worldPos.y - refHeight, 0.0);
    float heightTerm = exp(-heightAbove / max(params.medium_params.w, 1.0));
    vec3 metres = warpFogDomain(
        worldPos / WORLD_UNITS_PER_METER,
        params.temporal_params.z
    );
    float density = sampledDensity(metres, 96.0, 23.0);
    return heightTerm * mix(0.2, 1.35, density);
}

// Henyey-Greenstein single-lobe phase function. cos_theta is the
// cosine of the angle between the light incoming direction and the
// view direction (toward the camera). g controls anisotropy:
//   g = 0  : isotropic (1/4π)
//   g > 0  : forward scattering (haze, atmosphere — typical 0.3–0.8)
//   g < 0  : backward scattering (rare in natural media)
float henyey_greenstein(float cos_theta, float g) {
    // HG is only defined for g ∈ (-1, 1). The UBO field is exposed for
    // runtime tuning (console / weather record) so a console-set 1.0
    // or out-of-range value would zero the numerator and trip the
    // already-present `max(denom, 1e-4)` floor — producing 0/very-small
    // = 0 rather than a NaN, but conceptually broken. Clamp here turns
    // that into a soft cap right at the phase-function boundary so
    // host bugs degrade gracefully. Current host default g = 0.4
    // (DEFAULT_PHASE_G in volumetrics.rs) is well inside the band, so
    // the clamp is a no-op on the hot path. See #1021 / REN-D18-002.
    float g_safe = clamp(g, -0.999, 0.999);
    float g2 = g_safe * g_safe;
    float denom = 1.0 + g2 - 2.0 * g_safe * cos_theta;
    return (1.0 - g2) / (4.0 * PI * pow(max(denom, 1e-4), 1.5));
}

float sliceDistance(float normalizedSlice) {
    float u = clamp(normalizedSlice, 0.0, 1.0);
    float farDistance = max(params.volume_params.x, 1.0);
    float linearDepth = clamp(params.volume_params.y, 1.0, farDistance);
    float linearFraction = clamp(params.volume_params.z, 1.0e-4, 0.9999);
    if (u <= linearFraction) {
        return linearDepth * (u / linearFraction);
    }
    float q = (u - linearFraction) / (1.0 - linearFraction);
    return linearDepth * pow(farDistance / linearDepth, q);
}

float sliceCoordinate(float distanceAlongRay) {
    float farDistance = max(params.volume_params.x, 1.0);
    float linearDepth = clamp(params.volume_params.y, 1.0, farDistance);
    float linearFraction = clamp(params.volume_params.z, 1.0e-4, 0.9999);
    float d = clamp(distanceAlongRay, 0.0, farDistance);
    if (d <= linearDepth) {
        return linearFraction * (d / linearDepth);
    }
    return linearFraction + (1.0 - linearFraction)
        * log(d / linearDepth) / log(farDistance / linearDepth);
}

// Progressive best-candidate blue-noise ranks on a toroidal 8x8 tile
// (BLUE_NOISE_RANKS, #include "include/blue_noise.glsl" above). The
// compact constant avoids an extra texture fetch in this bandwidth-sensitive
// pass while preserving the high-frequency distribution temporal accumulation
// expects. Cranley-Patterson rotation below supplies the temporal dimension.
float blueNoiseRank(ivec2 pixel, int channel) {
    ivec2 tiled = ivec2(
        (pixel.x + channel * 3) & 7,
        (pixel.y + channel * 5) & 7
    );
    return (float(BLUE_NOISE_RANKS[tiled.y * 8 + tiled.x]) + 0.5) / 64.0;
}

vec3 froxelJitter(ivec3 coord) {
    float frame = params.volume_params.w;
    ivec2 p = coord.xy + ivec2(coord.z * 17, coord.z * 29);
    vec3 rank = vec3(
        blueNoiseRank(p, 0),
        blueNoiseRank(p.yx, 1),
        blueNoiseRank(p + ivec2(37, 11), 2)
    );
    return fract(rank + frame * vec3(0.754877666, 0.569840296, 0.438289));
}

// Reconstruct world position at a jittered froxel sample.
// uv ∈ [0,1] is screen space; t is along-ray distance from camera.
vec3 froxel_to_world(vec2 uv, float t) {
    // Get the world-space ray through this froxel column by inverting
    // the projection at the far plane (Vulkan default NDC z = 1 = far).
    vec4 ndc_far = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec4 world_far = params.inv_view_proj * ndc_far;
    world_far.xyz /= max(abs(world_far.w), 1.0e-6);
    // #markarth-precision — inv_view_proj is camera-relative; lift the far
    // point to ABSOLUTE world so the froxel positions (and the TLAS shadow
    // rays cast from them) share the absolute TLAS space. camera_pos is
    // already absolute.
    world_far.xyz += params.render_origin.xyz;
    vec3 ray_dir = normalize(world_far.xyz - params.camera_pos.xyz);
    return params.camera_pos.xyz + ray_dir * t;
}

bool reprojectHistory(vec3 worldPos, out vec3 previousUvw) {
    vec3 currentRelative = worldPos - params.render_origin.xyz;
    vec4 previousClip = params.prev_view_proj * vec4(currentRelative, 1.0);
    if (previousClip.w <= 1.0e-6) {
        return false;
    }
    vec2 previousUv = previousClip.xy / previousClip.w * 0.5 + 0.5;
    float previousDistance = length(worldPos - params.prev_camera_pos.xyz);
    float previousSlice = sliceCoordinate(previousDistance);
    previousUvw = vec3(previousUv, previousSlice);
    return all(greaterThanEqual(previousUvw, vec3(0.0)))
        && all(lessThanEqual(previousUvw, vec3(1.0)));
}

// Reproject within one prior camera-ray column. A trilinear sampler would
// interpolate XY history across walls and window frames before any temporal
// rejection can see it. Depth remains linear because adjacent Z texels are
// consecutive slabs along the same ray.
vec4 sampleHistoryColumn(vec3 uvw) {
    ivec3 size = textureSize(previousFroxel, 0);
    ivec2 column = clamp(
        ivec2(uvw.xy * vec2(size.xy)),
        ivec2(0),
        size.xy - ivec2(1)
    );
    float z = clamp(
        uvw.z * float(size.z) - 0.5,
        0.0,
        float(size.z - 1)
    );
    int z0 = int(floor(z));
    int z1 = min(z0 + 1, size.z - 1);
    return mix(
        texelFetch(previousFroxel, ivec3(column, z0), 0),
        texelFetch(previousFroxel, ivec3(column, z1), 0),
        fract(z)
    );
}

// Match `sampleHistoryColumn` exactly: nearest camera-ray column, linear
// interpolation only along consecutive depth slabs.
float sampleEmissionHistoryColumn(vec3 uvw) {
    ivec3 size = textureSize(previousEmissionHistory, 0);
    ivec2 column = clamp(
        ivec2(uvw.xy * vec2(size.xy)),
        ivec2(0),
        size.xy - ivec2(1)
    );
    float z = clamp(
        uvw.z * float(size.z) - 0.5,
        0.0,
        float(size.z - 1)
    );
    int z0 = int(floor(z));
    int z1 = min(z0 + 1, size.z - 1);
    return mix(
        texelFetch(previousEmissionHistory, ivec3(column, z0), 0).r,
        texelFetch(previousEmissionHistory, ivec3(column, z1), 0).r,
        fract(z)
    );
}

vec4 sanitizedChemistry(vec4 chemistry) {
    if (any(isnan(chemistry)) || any(isinf(chemistry))) {
        return vec4(0.0, AMBIENT_TEMPERATURE_K, 0.0, 0.0);
    }
    chemistry.x = clamp(chemistry.x, 0.0, 1.0);
    chemistry.y = chemistry.y > 1.0
        ? clamp(chemistry.y, AMBIENT_TEMPERATURE_K, MAX_COMBUSTION_TEMPERATURE_K)
        : AMBIENT_TEMPERATURE_K;
    chemistry.z = clamp(chemistry.z, 0.0, 0.20);
    chemistry.w = clamp(chemistry.w, 0.0, 64.0);
    return chemistry;
}

vec4 sanitizedDynamics(vec4 dynamics) {
    if (any(isnan(dynamics)) || any(isinf(dynamics))) {
        return vec4(0.0);
    }
    float maxSpeed = MAX_COMBUSTION_SPEED_MPS * WORLD_UNITS_PER_METER;
    float speed = length(dynamics.xyz);
    if (speed > maxSpeed) {
        dynamics.xyz *= maxSpeed / speed;
    }
    dynamics.w = clamp(
        dynamics.w,
        0.0,
        0.5 * MAX_COMBUSTION_SPEED_MPS * MAX_COMBUSTION_SPEED_MPS
    );
    return dynamics;
}

vec4 sanitizedOptical(vec4 optical) {
    if (any(isnan(optical)) || any(isinf(optical))) {
        return vec4(0.0);
    }
    optical.rgb = clamp(optical.rgb, vec3(0.0), vec3(0.20));
    optical.w = 0.0;
    return optical;
}

bool samplePreviousTransport(
    vec3 worldPos,
    out vec4 chemistry,
    out vec4 dynamics,
    out vec4 optical
) {
    chemistry = vec4(0.0, AMBIENT_TEMPERATURE_K, 0.0, 0.0);
    dynamics = vec4(0.0);
    optical = vec4(0.0);
    if (params.prev_camera_pos.w <= 0.5) {
        return false;
    }
    vec3 previousUvw;
    if (!reprojectHistory(worldPos, previousUvw)) {
        return false;
    }
    chemistry = sanitizedChemistry(texture(previousCombustionState, previousUvw));
    dynamics = sanitizedDynamics(texture(previousCombustionDynamics, previousUvw));
    optical = sanitizedOptical(texture(previousCombustionOptical, previousUvw));
    return true;
}

float combustionActivity(vec4 chemistry, vec4 optical);

// One concern-specific differential derived from the six transported
// neighbours. Pressure expansion, rotational flow, and the combustion
// interface all consume this same world-space reconstruction rather than
// restating camera-grid finite differences independently.
struct CombustionDifferential {
    vec3 pressureGradient;
    vec3 vorticity;
    vec3 activityGradient;
    float velocityDivergence;
};

// Recover physical derivatives from the frustum-aligned froxel basis. A plain
// sum of axis differences would treat the perspective grid as orthogonal and
// turn camera orientation into combustion dynamics. With neighbour values D
// and basis columns B, scalar gradients solve Bᵀ∇f = D while the velocity
// Jacobian solves J B = Dᵤ.
bool previousCombustionDifferential(
    vec3 worldPosition,
    vec3 stepX,
    vec3 stepY,
    vec3 stepZ,
    out CombustionDifferential differential
) {
    differential.pressureGradient = vec3(0.0);
    differential.vorticity = vec3(0.0);
    differential.activityGradient = vec3(0.0);
    differential.velocityDivergence = 0.0;
    mat3 basis = mat3(stepX, stepY, stepZ);
    float basisDeterminant = determinant(basis);
    if (abs(basisDeterminant) <= 1.0e-8) {
        return false;
    }

    vec3 offsets[6] = vec3[6](
        stepX, -stepX,
        stepY, -stepY,
        stepZ, -stepZ
    );
    vec4 chemistry[6];
    vec4 dynamics[6];
    vec4 optical[6];
    for (int neighborIndex = 0; neighborIndex < 6; ++neighborIndex) {
        if (!samplePreviousTransport(
                worldPosition + offsets[neighborIndex],
                chemistry[neighborIndex],
                dynamics[neighborIndex],
                optical[neighborIndex])) {
            return false;
        }
    }

    mat3 inverseBasis = inverse(basis);
    mat3 inverseBasisTranspose = transpose(inverseBasis);
    vec3 pressureDifferences = 0.5 * vec3(
        dynamics[0].w - dynamics[1].w,
        dynamics[2].w - dynamics[3].w,
        dynamics[4].w - dynamics[5].w
    );
    differential.pressureGradient =
        inverseBasisTranspose * pressureDifferences;

    mat3 velocityDifferences = mat3(
        0.5 * (dynamics[0].xyz - dynamics[1].xyz),
        0.5 * (dynamics[2].xyz - dynamics[3].xyz),
        0.5 * (dynamics[4].xyz - dynamics[5].xyz)
    );
    mat3 velocityJacobian = velocityDifferences * inverseBasis;
    differential.vorticity = vec3(
        velocityJacobian[1][2] - velocityJacobian[2][1],
        velocityJacobian[2][0] - velocityJacobian[0][2],
        velocityJacobian[0][1] - velocityJacobian[1][0]
    );
    differential.velocityDivergence = velocityJacobian[0][0]
        + velocityJacobian[1][1]
        + velocityJacobian[2][2];

    vec3 activityDifferences = 0.5 * vec3(
        combustionActivity(chemistry[0], optical[0])
            - combustionActivity(chemistry[1], optical[1]),
        combustionActivity(chemistry[2], optical[2])
            - combustionActivity(chemistry[3], optical[3]),
        combustionActivity(chemistry[4], optical[4])
            - combustionActivity(chemistry[5], optical[5])
    );
    differential.activityGradient =
        inverseBasisTranspose * activityDifferences;

    return !any(isnan(differential.pressureGradient))
        && !any(isinf(differential.pressureGradient))
        && !any(isnan(differential.vorticity))
        && !any(isinf(differential.vorticity))
        && !any(isnan(differential.activityGradient))
        && !any(isinf(differential.activityGradient))
        && !isnan(differential.velocityDivergence)
        && !isinf(differential.velocityDivergence);
}

bool carriesCombustion(vec4 chemistry, vec4 optical) {
    return chemistry.x > 1.0e-4
        || chemistry.z > 1.0e-6
        || any(greaterThan(optical.rgb, vec3(1.0e-6)))
        || chemistry.w > 1.0e-4
        || chemistry.y > AMBIENT_TEMPERATURE_K + 2.0;
}

float combustionActivity(vec4 chemistry, vec4 optical) {
    float temperatureExcess = max(
        (chemistry.y - AMBIENT_TEMPERATURE_K) / AMBIENT_TEMPERATURE_K,
        0.0
    );
    float spectralScattering = max(optical.r, max(optical.g, optical.b));
    return clamp(
        chemistry.x + max(chemistry.z, spectralScattering) * 80.0
            + temperatureExcess * 0.12,
        0.0,
        1.0
    );
}

bool rigidBoundaryNormal(
    uint instanceIndex,
    uint primitiveIndex,
    out vec3 boundaryNormal
) {
    boundaryNormal = vec3(0.0);
    if (instanceIndex >= uint(boundaryInstances.length())) {
        return false;
    }
    GpuBoundaryInstance instance = boundaryInstances[instanceIndex];
    // Skinned BLAS vertices are deformed into a separate per-entity buffer;
    // the global SSBO remains bind pose. Fall back to the conservative ray
    // direction for those hits rather than publishing a confidently wrong
    // normal.
    if (instance.boneOffset != 0u) {
        return false;
    }

    uint indexCount = uint(boundaryIndexData.length());
    if (instance.indexOffset > indexCount) {
        return false;
    }
    uint remainingIndices = indexCount - instance.indexOffset;
    if (primitiveIndex >= remainingIndices / 3u) {
        return false;
    }
    uint firstIndex = instance.indexOffset + primitiveIndex * 3u;
    uvec3 localIndices = uvec3(
        boundaryIndexData[firstIndex],
        boundaryIndexData[firstIndex + 1u],
        boundaryIndexData[firstIndex + 2u]
    );
    if (any(greaterThanEqual(localIndices, uvec3(instance.vertexCount)))) {
        return false;
    }

    uint vertexCapacity = uint(boundaryVertexData.length()) / VERTEX_STRIDE_FLOATS;
    if (instance.vertexOffset > vertexCapacity
        || any(greaterThanEqual(
            localIndices,
            uvec3(vertexCapacity - instance.vertexOffset)
        ))) {
        return false;
    }
    uvec3 globalIndices = uvec3(instance.vertexOffset) + localIndices;
    uint base0 = globalIndices.x * VERTEX_STRIDE_FLOATS;
    uint base1 = globalIndices.y * VERTEX_STRIDE_FLOATS;
    uint base2 = globalIndices.z * VERTEX_STRIDE_FLOATS;
    vec3 local0 = vec3(
        boundaryVertexData[base0],
        boundaryVertexData[base0 + 1u],
        boundaryVertexData[base0 + 2u]
    );
    vec3 local1 = vec3(
        boundaryVertexData[base1],
        boundaryVertexData[base1 + 1u],
        boundaryVertexData[base1 + 2u]
    );
    vec3 local2 = vec3(
        boundaryVertexData[base2],
        boundaryVertexData[base2 + 1u],
        boundaryVertexData[base2 + 2u]
    );
    vec3 world0 = (instance.model * vec4(local0, 1.0)).xyz;
    vec3 world1 = (instance.model * vec4(local1, 1.0)).xyz;
    vec3 world2 = (instance.model * vec4(local2, 1.0)).xyz;
    vec3 unnormalized = cross(world1 - world0, world2 - world0);
    float lengthSquared = dot(unnormalized, unnormalized);
    if (!(lengthSquared > 1.0e-12)
        || isnan(lengthSquared)
        || isinf(lengthSquared)) {
        return false;
    }
    boundaryNormal = unnormalized * inversesqrt(lengthSquared);
    return true;
}

// Both backward advection and the forward velocity update use this one
// canonical solid-boundary query. Glass blocks transported matter even though
// it transmits light; effect cards do neither. A malformed/degenerate or
// skinned hit still blocks transport and receives a conservative normal that
// cancels motion into the committed surface.
bool combustionPathBlocked(
    vec3 sourcePosition,
    vec3 destinationPosition,
    out vec3 boundaryNormal
) {
    boundaryNormal = vec3(0.0);
    vec3 displacement = destinationPosition - sourcePosition;
    float distance = length(displacement);
    if (distance <= 0.04) {
        return false;
    }
    vec3 direction = displacement / distance;
    float inset = min(0.02, distance * 0.25);
    rayQueryEXT boundaryQuery;
    rayQueryInitializeEXT(
        boundaryQuery,
        topLevelAS,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        VISIBILITY_MASK_SOLID,
        sourcePosition,
        inset,
        direction,
        distance - inset
    );
    while (rayQueryProceedEXT(boundaryQuery)) {}
    if (rayQueryGetIntersectionTypeEXT(boundaryQuery, true)
        == gl_RayQueryCommittedIntersectionNoneEXT) {
        return false;
    }

    uint instanceIndex = uint(
        rayQueryGetIntersectionInstanceCustomIndexEXT(boundaryQuery, true));
    uint primitiveIndex = uint(
        rayQueryGetIntersectionPrimitiveIndexEXT(boundaryQuery, true));
    if (!rigidBoundaryNormal(instanceIndex, primitiveIndex, boundaryNormal)) {
        boundaryNormal = -direction;
    } else if (dot(boundaryNormal, direction) > 0.0) {
        boundaryNormal = -boundaryNormal;
    }
    return true;
}

vec3 atmosphericWindVelocity(vec3 worldPos);

// Semi-Lagrangian advection normally backtraces with the velocity already at
// the destination. That is insufficient at a plume's leading edge: the empty
// destination has zero velocity, so it can never discover the active cell
// immediately upwind. Extend only velocity (not chemistry) from an adjacent
// active cell whose flow points toward this destination. Chemistry still
// arrives through the ordinary backtrace, preserving mass-like interpolation
// and the solid-crossing rejection below.
bool incomingDynamicsFromNeighbors(
    vec3 worldPos,
    vec3 stepX,
    vec3 stepY,
    vec3 stepZ,
    out vec4 incomingDynamics
) {
    vec3 offsets[6] = vec3[6](
        stepX, -stepX,
        stepY, -stepY,
        stepZ, -stepZ
    );
    bool found = false;
    float bestScore = 0.0;
    incomingDynamics = vec4(0.0);
    for (int neighborIndex = 0; neighborIndex < 6; ++neighborIndex) {
        vec3 candidatePosition = worldPos + offsets[neighborIndex];
        vec4 candidateChemistry;
        vec4 candidateDynamics;
        vec4 candidateOptical;
        if (!samplePreviousTransport(
                candidatePosition,
                candidateChemistry,
                candidateDynamics,
                candidateOptical)
            || !carriesCombustion(candidateChemistry, candidateOptical)) {
            continue;
        }

        vec3 towardDestination = worldPos - candidatePosition;
        float neighborDistance = length(towardDestination);
        if (neighborDistance <= 1.0e-4) {
            continue;
        }
        float closingSpeed = dot(
            candidateDynamics.xyz + atmosphericWindVelocity(candidatePosition),
            towardDestination / neighborDistance
        );
        if (closingSpeed <= 0.04) {
            continue;
        }
        vec3 crossingNormal;
        if (combustionPathBlocked(
                candidatePosition,
                worldPos,
                crossingNormal)) {
            continue;
        }

        float activity = combustionActivity(candidateChemistry, candidateOptical);
        float score = closingSpeed * (0.25 + activity);
        if (!found || score > bestScore) {
            found = true;
            bestScore = score;
            incomingDynamics = candidateDynamics;
        }
    }
    return found;
}

// Weather wind is an external advection field, not a force written into the
// transported velocity image. Keeping the two separate is important: a gust
// can change between frames without being integrated repeatedly into an
// ever-growing velocity. The small spatial phase gives a coherent front to
// the gust instead of making every smoke column pulse in lockstep. A mild
// height shear lets the upper plume outrun its grounded source, which is what
// exposes the roll-up/vortex structure instead of translating a rigid blob.
vec3 atmosphericWindVelocity(vec3 worldPos) {
    vec2 direction = params.wind_params.xy;
    float directionLength = length(direction);
    if (directionLength <= 1.0e-5) {
        return vec3(0.0);
    }
    direction /= directionLength;
    float baseSpeed = max(params.wind_params.z, 0.0);
    float gustAmplitude = max(params.wind_params.w, 0.0);
    float gustFrequency = max(params.wind_gust.x, 0.0);
    float phase = params.temporal_params.z
        * gustFrequency
        * 2.0 * PI
        + dot(worldPos.xz, direction) * 0.008;
    float speed = max(baseSpeed + gustAmplitude * sin(phase), 0.0);
    float heightMetres = (worldPos.y - params.fog_reference.x)
        / WORLD_UNITS_PER_METER;
    float shear = mix(0.72, 1.18, smoothstep(-2.0, 18.0, heightMetres));
    return vec3(direction.x, 0.0, direction.y) * speed * shear;
}

// Advect in absolute world space even though storage is view-froxel aligned.
// RK2 backtracing reduces the directional bias of first-order Euler transport:
// sample velocity at the destination, estimate a midpoint, then use midpoint
// velocity for the final source position in the previous grid.
void transportCombustion(
    vec3 worldPos,
    vec3 segmentStart,
    vec3 segmentEnd,
    vec3 neighborStepX,
    vec3 neighborStepY,
    vec3 neighborStepZ,
    float dt,
    out vec4 chemistry,
    out vec4 dynamics,
    out vec4 optical
) {
    vec4 probeChemistry;
    vec4 destinationDynamics;
    vec4 probeOptical;
    bool hadHistory = samplePreviousTransport(
        worldPos,
        probeChemistry,
        destinationDynamics,
        probeOptical
    );
    if (hadHistory && dt > 0.0) {
        bool destinationDynamicsExtended = false;
        if (combustionActivity(probeChemistry, probeOptical) < 0.08) {
            vec4 incomingDynamics;
            if (incomingDynamicsFromNeighbors(
                    worldPos,
                    neighborStepX,
                    neighborStepY,
                    neighborStepZ,
                    incomingDynamics)) {
                destinationDynamics = incomingDynamics;
                destinationDynamicsExtended = true;
            }
        }
        vec3 destinationWind = atmosphericWindVelocity(worldPos);
        vec3 midpoint = worldPos
            - (destinationDynamics.xyz + destinationWind) * (0.5 * dt);
        vec4 midpointChemistry;
        vec4 midpointDynamics;
        vec4 midpointOptical;
        if (destinationDynamicsExtended
            || !samplePreviousTransport(
                midpoint,
                midpointChemistry,
                midpointDynamics,
                midpointOptical)) {
            midpointDynamics = destinationDynamics;
        }
        vec3 midpointWind = atmosphericWindVelocity(midpoint);
        vec3 sourcePosition = worldPos
            - (midpointDynamics.xyz + midpointWind) * dt;
        vec4 sourceChemistry;
        vec4 sourceDynamics;
        vec4 sourceOptical;
        bool sourceInHistory = samplePreviousTransport(
            sourcePosition,
            sourceChemistry,
            sourceDynamics,
            sourceOptical
        );
        // Test the state being pulled into this destination, not the state
        // already living here. A previously empty cell on the far side of a
        // wall is exactly where a source-side check matters: gating on
        // `probeChemistry` lets active chemistry tunnel into that empty cell
        // without ever issuing the TLAS query.
        vec3 crossingNormal;
        bool blocked = sourceInHistory
            && carriesCombustion(sourceChemistry, sourceOptical)
            && combustionPathBlocked(sourcePosition, worldPos, crossingNormal);
        if (blocked) {
            chemistry = probeChemistry;
            dynamics = destinationDynamics;
            optical = probeOptical;
        } else if (sourceInHistory
            && carriesCombustion(sourceChemistry, sourceOptical)) {
            chemistry = sourceChemistry;
            dynamics = sourceDynamics;
            optical = sourceOptical;
        } else {
            chemistry = probeChemistry;
            dynamics = destinationDynamics;
            optical = probeOptical;
        }
    } else {
        chemistry = hadHistory
            ? probeChemistry
            : vec4(0.0, AMBIENT_TEMPERATURE_K, 0.0, 0.0);
        dynamics = hadHistory
            ? destinationDynamics
            : vec4(0.0);
        optical = hadHistory
            ? probeOptical
            : vec4(0.0);
    }

    chemistry = sanitizedChemistry(chemistry);
    dynamics = sanitizedDynamics(dynamics);
    optical = sanitizedOptical(optical);
    applyCombustionSources(
        worldPos,
        segmentStart,
        segmentEnd,
        chemistry,
        dynamics,
        optical,
        dt
    );

    if (dt > 0.0) {
        float ignition = smoothstep(
            IGNITION_TEMPERATURE_K - 90.0,
            IGNITION_TEMPERATURE_K + 180.0,
            chemistry.y
        );
        // `chemistry.x` is the canonical normalized fuel fraction. The
        // complementary fraction is available oxidizer, so a fuel-rich core
        // burns more slowly and produces more soot than a dilute edge. This
        // is shared thermochemistry, not a source/profile heuristic.
        float fuelFraction = clamp(chemistry.x, 0.0, 1.0);
        float oxidizer = 1.0 - fuelFraction;
        float reactionRate = COMBUSTION_REACTION_RATE_PER_SECOND
            * fuelFraction
            * oxidizer
            * ignition;
        float burnedFuel = min(fuelFraction, reactionRate * dt);
        chemistry.x -= burnedFuel;
        // Reaction heat approaches the canonical adiabatic equilibrium; it
        // is not a fixed kelvin increment. This makes the update independent
        // of timestep partitioning and, crucially, does not keep reheating an
        // explosion that entered the field hotter than an open flame.
        float temperatureDeficit = max(
            ADIABATIC_FLAME_TEMPERATURE_K - chemistry.y,
            0.0
        );
        float reactionHeatFraction = 1.0 - exp(
            -COMBUSTION_REACTION_HEAT_RESPONSE * burnedFuel
        );
        chemistry.y += temperatureDeficit * reactionHeatFraction;
        // Soot yield falls when oxidizer is abundant and rises in a rich,
        // oxygen-starved flame. Encode it directly as canonical total
        // extinction plus spectral scattering, so radiative transfer needs no
        // later age/material conversion.
        float sootYield = mix(
            COMBUSTION_RICH_SOOT_YIELD,
            COMBUSTION_LEAN_SOOT_YIELD,
            oxidizer
        );
        float sootSigmaT = burnedFuel * sootYield;
        chemistry.z += sootSigmaT;
        optical.rgb += sootSigmaT
            * vec3(COMBUSTION_SOOT_SINGLE_SCATTER_ALBEDO);
        float hotSootOxidation = smoothstep(
                COMBUSTION_SOOT_OXIDATION_START_TEMPERATURE_K,
                COMBUSTION_SOOT_OXIDATION_FULL_TEMPERATURE_K,
                chemistry.y
            )
            * oxidizer;
        float sootRetention = exp(
            -COMBUSTION_SOOT_OXIDATION_RATE_PER_SECOND
                * hotSootOxidation
                * dt
        );
        chemistry.z *= sootRetention;
        optical.rgb *= sootRetention;

        chemistry.x *= exp(
            -COMBUSTION_FUEL_VAPOUR_REMOVAL_PER_SECOND * dt
        );
        // Soot is transported matter, not another emissive time envelope.
        // Let advection and mixing disperse it; this mild settling/removal term
        // gives a ~15 s half-life instead of erasing an explosion cloud in the
        // first few seconds after its heat has cooled.
        chemistry.z *= exp(-COMBUSTION_AEROSOL_DISSIPATION_PER_SECOND * dt);
        optical.rgb *= exp(-COMBUSTION_AEROSOL_DISSIPATION_PER_SECOND * dt);
        chemistry.w *= exp(
            -COMBUSTION_RADIANCE_REMOVAL_PER_SECOND * dt
        );
        chemistry.y = AMBIENT_TEMPERATURE_K
            + (chemistry.y - AMBIENT_TEMPERATURE_K) * exp(
                -COMBUSTION_THERMAL_COOLING_PER_SECOND * dt
            );

        float activity = combustionActivity(chemistry, optical);
        CombustionDifferential differential;
        bool hasDifferential = false;
        if (dynamics.w > 1.0e-5 || activity > 0.01) {
            hasDifferential = previousCombustionDifferential(
                worldPos,
                neighborStepX,
                neighborStepY,
                neighborStepZ,
                differential
            );
        }

        // Positive divergence is resolved volumetric expansion. Dilute all
        // transported per-volume chemistry and radiance with that same local
        // Jacobian so an expanding fireball cannot keep a constant-density
        // sphere while its velocity field grows. Compression is left to
        // advection and bounded source injection rather than amplifying a
        // noisy finite difference.
        if (hasDifferential) {
            float dilutionRate = clamp(
                differential.velocityDivergence,
                0.0,
                COMBUSTION_MAX_DILUTION_RATE_PER_SECOND
            );
            float dilution = exp(-dilutionRate * dt);
            chemistry.x *= dilution;
            chemistry.z *= dilution;
            chemistry.w *= dilution;
            optical.rgb *= dilution;
        }

        // Specific overpressure q is transported beside velocity but remains
        // source-agnostic after injection. Recover -grad(q) in world space so
        // every pressure-producing source expands through the same dynamics
        // contract, then let the short pressure phase decay before buoyancy
        // owns the cooled plume. q is stored in m²/s² while the grid basis is
        // expressed in world units, hence the squared world-unit conversion.
        if (dynamics.w > 1.0e-5) {
            if (hasDifferential) {
                vec3 pressureAcceleration = -differential.pressureGradient
                    * (WORLD_UNITS_PER_METER * WORLD_UNITS_PER_METER);
                float pressureAccelerationLength = length(pressureAcceleration);
                float maxPressureAcceleration =
                    COMBUSTION_MAX_PRESSURE_ACCELERATION_MPS2
                    * WORLD_UNITS_PER_METER;
                if (pressureAccelerationLength > maxPressureAcceleration) {
                    pressureAcceleration *= maxPressureAcceleration
                        / pressureAccelerationLength;
                }
                dynamics.xyz += pressureAcceleration * dt;
            }
            dynamics.w *= exp(
                -COMBUSTION_OVERPRESSURE_DISSIPATION_PER_SECOND * dt
            );
        }

        // Semi-Lagrangian advection damps curl most aggressively at a thin
        // fire/smoke interface. Use the same transported-neighbour
        // differential to restore rotational motion there. This is an
        // interface force, not an explosion/flame profile branch: any hot or
        // optically active transported medium follows the same contract.
        if (hasDifferential && activity > 0.01) {
            float interfaceGradientLength =
                length(differential.activityGradient);
            float vorticityLength = length(differential.vorticity);
            float meanStepWorld = (
                length(neighborStepX)
                    + length(neighborStepY)
                    + length(neighborStepZ)
            ) / 3.0;
            float interfaceContrast = clamp(
                interfaceGradientLength * meanStepWorld,
                0.0,
                1.0
            );
            if (interfaceGradientLength > 1.0e-7
                && vorticityLength > 1.0e-4
                && interfaceContrast > 0.005) {
                vec3 interfaceNormal = differential.activityGradient
                    / interfaceGradientLength;
                // A pressure-dominated front should remain an expanding
                // blast, not immediately turn its discretization curl into
                // tangential motion. As transported q decays, confinement
                // fades in continuously and rolls the decompressed hot-gas /
                // smoke interface without knowing which source created it.
                float decompressedWeight = 1.0 - smoothstep(
                    0.04,
                    0.40,
                    dynamics.w
                );
                float confinementWeight = activity
                    * decompressedWeight
                    * smoothstep(0.005, 0.18, interfaceContrast);
                vec3 vorticityAcceleration = cross(
                    interfaceNormal,
                    differential.vorticity
                ) * (
                    COMBUSTION_VORTICITY_CONFINEMENT_SPEED_MPS
                        * WORLD_UNITS_PER_METER
                        * confinementWeight
                );
                float vorticityAccelerationLength =
                    length(vorticityAcceleration);
                float maxVorticityAcceleration =
                    COMBUSTION_MAX_VORTICITY_ACCELERATION_MPS2
                    * WORLD_UNITS_PER_METER;
                if (vorticityAccelerationLength > maxVorticityAcceleration) {
                    vorticityAcceleration *= maxVorticityAcceleration
                        / vorticityAccelerationLength;
                }
                dynamics.xyz += vorticityAcceleration * dt;
            }
        }

        float temperatureExcess = max(
            (chemistry.y - AMBIENT_TEMPERATURE_K) / AMBIENT_TEMPERATURE_K,
            0.0
        );
        float buoyantAcceleration = min(temperatureExcess, 7.0)
            * COMBUSTION_THERMAL_BUOYANCY_ACCELERATION_MPS2
            * WORLD_UNITS_PER_METER;
        dynamics.y += buoyantAcceleration * dt;
        float aerosolLift = clamp(
            chemistry.z * COMBUSTION_AEROSOL_LIFT_EXTINCTION_SCALE,
            0.0,
            1.0
        ) * COMBUSTION_AEROSOL_LIFT_ACCELERATION_MPS2
            * WORLD_UNITS_PER_METER;
        dynamics.y += aerosolLift * dt;

        vec3 metres = worldPos / WORLD_UNITS_PER_METER;
        float coarseWaveNumber = 2.0 * PI
            / COMBUSTION_TURBULENCE_COARSE_EDDY_SCALE_METERS;
        float detailWaveNumber = 2.0 * PI
            / COMBUSTION_TURBULENCE_DETAIL_EDDY_SCALE_METERS;
        vec3 coarseCurl = curlField(
            metres * coarseWaveNumber
                + vec3(
                    0.06,
                    -COMBUSTION_TURBULENCE_COARSE_RISE_SPEED_MPS,
                    0.04
                ) * (coarseWaveNumber * params.temporal_params.z)
        );
        const float detailRotation = 0.7417649321;
        vec3 detailCurl = rotateY(
            curlField(
                rotateY(metres, detailRotation) * detailWaveNumber
                    + vec3(
                        -0.08,
                        -COMBUSTION_TURBULENCE_DETAIL_RISE_SPEED_MPS,
                        0.11
                    ) * (detailWaveNumber * params.temporal_params.z)
            ),
            -detailRotation
        );
        vec3 turbulentAcceleration = (
            coarseCurl * 0.72 + detailCurl * 0.42
        ) * (1.6 * WORLD_UNITS_PER_METER * activity);
        dynamics.xyz += turbulentAcceleration * dt;
        dynamics.xyz *= exp(
            -COMBUSTION_VELOCITY_DAMPING_PER_SECOND * dt
        );

        // Semi-Lagrangian no-through rejection above protects the empty side
        // of a wall. This forward probe handles the complementary source-side
        // boundary condition: remove only the inward normal component of the
        // updated flow and retain tangential slip with mild wall friction.
        if (carriesCombustion(chemistry, optical)
            && dot(dynamics.xyz, dynamics.xyz) > 1.0e-8) {
            vec3 boundaryNormal;
            vec3 predictedPosition = worldPos
                + (dynamics.xyz + atmosphericWindVelocity(worldPos)) * dt;
            if (combustionPathBlocked(
                    worldPos,
                    predictedPosition,
                    boundaryNormal)) {
                float inwardSpeed = min(dot(dynamics.xyz, boundaryNormal), 0.0);
                dynamics.xyz -= boundaryNormal * inwardSpeed;
                dynamics.xyz *= exp(-COMBUSTION_WALL_FRICTION_PER_SECOND * dt);
            }
        }
    }

    chemistry = sanitizedChemistry(chemistry);
    dynamics = sanitizedDynamics(dynamics);
    optical = sanitizedOptical(optical);
}

LocalMedium combustionMedium(vec4 chemistry, vec4 optical) {
    LocalMedium medium = emptyLocalMedium();
    chemistry = sanitizedChemistry(chemistry);
    optical = sanitizedOptical(optical);
    float fuelVapourSigmaT = chemistry.x * COMBUSTION_FUEL_VAPOUR_SIGMA_T;
    float sigmaT = chemistry.z + fuelVapourSigmaT;
    if (sigmaT <= 1.0e-7) {
        return medium;
    }

    vec3 sigmaS = optical.rgb
        + fuelVapourSigmaT * vec3(COMBUSTION_FUEL_VAPOUR_SINGLE_SCATTER_ALBEDO);
    sigmaS = clamp(sigmaS, vec3(0.0), vec3(sigmaT));
    vec3 sigmaA = vec3(sigmaT) - sigmaS;
    medium.extinction = sigmaT;
    medium.scattering = sigmaS;

    float thermalLuma = chemistry.w
        * blackbodyVisibleRadianceRatio(chemistry.y, 1850.0);
    vec3 thermalRadiance = blackbodyChromaticity(chemistry.y) * thermalLuma;
    medium.emission = sigmaA * thermalRadiance;
    return medium;
}

// Beer-Lambert attenuation along the light path through the previous
// canonical combustion field. The current field is being written by this
// dispatch, so sampling the previous frame is both race-free and temporally
// consistent with semi-Lagrangian advection. Quadratically partitioned
// intervals concentrate samples near the receiver, where narrow flame and
// smoke columns would be missed by uniform samples across a long sun ray.
float transportedCombustionTransmittance(
    vec3 worldPosition,
    vec3 directionTowardLight,
    float maxDistance,
    float samplePhase
) {
    if (params.prev_camera_pos.w <= 0.5 || maxDistance <= 0.05) {
        return 1.0;
    }
    float directionLength = length(directionTowardLight);
    if (directionLength <= 1.0e-6) {
        return 1.0;
    }

    vec3 rayDirection = directionTowardLight / directionLength;
    float traceDistance = min(
        maxDistance,
        COMBUSTION_LIGHT_TRANSMITTANCE_REACH_METERS * WORLD_UNITS_PER_METER
    );
    float phase = clamp(samplePhase, 0.0, 1.0);
    float opticalDepth = 0.0;
    for (int stepIndex = 0;
        stepIndex < COMBUSTION_LIGHT_TRANSMITTANCE_STEPS;
        ++stepIndex) {
        float intervalStart = float(stepIndex)
            / float(COMBUSTION_LIGHT_TRANSMITTANCE_STEPS);
        float intervalEnd = float(stepIndex + 1)
            / float(COMBUSTION_LIGHT_TRANSMITTANCE_STEPS);
        float distanceStart = intervalStart * intervalStart * traceDistance;
        float distanceEnd = intervalEnd * intervalEnd * traceDistance;
        float sampleDistance = mix(distanceStart, distanceEnd, phase);
        vec3 previousUvw;
        if (!reprojectHistory(
                worldPosition + rayDirection * sampleDistance,
                previousUvw)) {
            continue;
        }
        vec4 chemistry = sanitizedChemistry(
            texture(previousCombustionState, previousUvw)
        );
        float sigmaT = chemistry.z
            + chemistry.x * COMBUSTION_FUEL_VAPOUR_SIGMA_T;
        opticalDepth += sigmaT * (distanceEnd - distanceStart);
    }
    return exp(-clamp(opticalDepth, 0.0, 20.0));
}

uint quantizeCombustionMoment(float value, float scale) {
    if (!(value > 0.0) || isnan(value) || isinf(value)) {
        return 0u;
    }
    // Bound one invocation so even a corrupted half-float field cannot make
    // one atomic contribution wrap a whole bin. The grid domain and ordinary
    // sparse occupancy keep the aggregate comfortably below uint32 max.
    return uint(min(floor(value * scale + 0.5), 65535.0));
}

void accumulateCombustionLightMoment(
    ivec3 coord,
    ivec3 froxelSize,
    vec3 worldPosition,
    float slabFront,
    float slabBack,
    LocalMedium medium
) {
    if (medium.extinction <= 1.0e-7
        || dot(medium.emission, LUMA_REC709) <= 1.0e-7) {
        return;
    }

    const vec3 halfExtentMetres = vec3(
        COMBUSTION_LIGHT_HALF_EXTENT_XZ_METERS,
        COMBUSTION_LIGHT_HALF_EXTENT_Y_METERS,
        COMBUSTION_LIGHT_HALF_EXTENT_XZ_METERS
    );
    vec3 offsetMetres = (worldPosition - params.camera_pos.xyz)
        / WORLD_UNITS_PER_METER;
    vec3 domain = (offsetMetres + halfExtentMetres) / (2.0 * halfExtentMetres);
    if (any(lessThan(domain, vec3(0.0)))
        || any(greaterThanEqual(domain, vec3(1.0)))) {
        return;
    }

    const uvec3 gridSize = uvec3(
        COMBUSTION_LIGHT_GRID_X,
        COMBUSTION_LIGHT_GRID_Y,
        COMBUSTION_LIGHT_GRID_Z
    );
    uvec3 bin = min(uvec3(floor(domain * vec3(gridSize))), gridSize - uvec3(1u));
    uint binIndex = bin.x + gridSize.x * (bin.y + gridSize.y * bin.z);
    vec3 withinBin = fract(domain * vec3(gridSize));

    // Mid-slab frustum-cell volume. The four reconstructed ray positions form
    // the cross-section; multiplying its two-triangle area by slab depth is a
    // conservative local quadrature for the truncated frustum cell.
    vec2 uv0 = vec2(coord.xy) / vec2(froxelSize.xy);
    vec2 uv1 = vec2(coord.xy + ivec2(1)) / vec2(froxelSize.xy);
    float slabMid = 0.5 * (slabFront + slabBack);
    vec3 p00 = froxel_to_world(uv0, slabMid);
    vec3 p10 = froxel_to_world(vec2(uv1.x, uv0.y), slabMid);
    vec3 p01 = froxel_to_world(vec2(uv0.x, uv1.y), slabMid);
    vec3 p11 = froxel_to_world(uv1, slabMid);
    float crossSection = 0.5 * length(cross(p10 - p00, p01 - p00))
        + 0.5 * length(cross(p11 - p10, p11 - p01));
    float cellVolumeWorld = crossSection * max(slabBack - slabFront, 0.0);
    if (!(cellVolumeWorld > 0.0) || isnan(cellVolumeWorld) || isinf(cellVolumeWorld)) {
        return;
    }

    // `medium.emission` is j = sigma_a * L_e per Bethesda unit. Integrating
    // over BU^3 yields intensity times BU^2, hence the BU^2 -> m^2 divisor.
    // The escape probability prevents an optically thick cell from exporting
    // emission that its own soot would absorb before reaching the boundary.
    float characteristicLength = pow(cellVolumeWorld, 1.0 / 3.0);
    float opticalDepth = medium.extinction * characteristicLength;
    float escapeProbability = opticalDepth > 1.0e-4
        ? (1.0 - exp(-opticalDepth)) / opticalDepth
        : 1.0;
    vec3 radiantIntensity = medium.emission * cellVolumeWorld
        * escapeProbability
        / (WORLD_UNITS_PER_METER * WORLD_UNITS_PER_METER);
    float luma = dot(radiantIntensity, LUMA_REC709);
    uint qWeight = quantizeCombustionMoment(luma, COMBUSTION_LIGHT_FIXED_SCALE);
    if (qWeight == 0u) {
        return;
    }

    atomicAdd(combustionLightMoments[binIndex].weight, qWeight);
    atomicAdd(
        combustionLightMoments[binIndex].weighted_x,
        uint(floor(withinBin.x * float(qWeight) + 0.5))
    );
    atomicAdd(
        combustionLightMoments[binIndex].weighted_y,
        uint(floor(withinBin.y * float(qWeight) + 0.5))
    );
    atomicAdd(
        combustionLightMoments[binIndex].weighted_z,
        uint(floor(withinBin.z * float(qWeight) + 0.5))
    );
    atomicAdd(
        combustionLightMoments[binIndex].radiant_r,
        quantizeCombustionMoment(radiantIntensity.r, COMBUSTION_LIGHT_FIXED_SCALE)
    );
    atomicAdd(
        combustionLightMoments[binIndex].radiant_g,
        quantizeCombustionMoment(radiantIntensity.g, COMBUSTION_LIGHT_FIXED_SCALE)
    );
    atomicAdd(
        combustionLightMoments[binIndex].radiant_b,
        quantizeCombustionMoment(radiantIntensity.b, COMBUSTION_LIGHT_FIXED_SCALE)
    );
    atomicAdd(
        combustionLightMoments[binIndex].luminous_volume,
        quantizeCombustionMoment(
            cellVolumeWorld
                / (WORLD_UNITS_PER_METER * WORLD_UNITS_PER_METER * WORLD_UNITS_PER_METER),
            COMBUSTION_LIGHT_VOLUME_FIXED_SCALE
        )
    );
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(froxel);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }

    vec3 jitter = froxelJitter(coord);
    vec2 sampleUv = (vec2(coord.xy) + jitter.xy) / vec2(size.xy);
    vec2 fieldUv = (vec2(coord.xy) + vec2(0.5)) / vec2(size.xy);
    float sliceFront = float(coord.z) / float(size.z);
    float sliceBack = float(coord.z + 1) / float(size.z);
    float t = mix(sliceDistance(sliceFront), sliceDistance(sliceBack), jitter.z);
    float fieldFrontT = sliceDistance(sliceFront);
    float fieldBackT = sliceDistance(sliceBack);
    float fieldT = 0.5 * (fieldFrontT + fieldBackT);

    vec3 world_pos = froxel_to_world(sampleUv, t);
    vec3 field_segment_start = froxel_to_world(fieldUv, fieldFrontT);
    vec3 field_segment_end = froxel_to_world(fieldUv, fieldBackT);
    vec3 field_world_pos = froxel_to_world(fieldUv, fieldT);
    vec2 fieldTexel = 1.0 / vec2(size.xy);
    vec3 neighbor_step_x = froxel_to_world(
        fieldUv + vec2(fieldTexel.x, 0.0),
        fieldT
    ) - field_world_pos;
    vec3 neighbor_step_y = froxel_to_world(
        fieldUv + vec2(0.0, fieldTexel.y),
        fieldT
    ) - field_world_pos;
    vec3 neighbor_step_z = field_segment_end - field_segment_start;
    float simulationDt = clamp(params.fog_reference.w, 0.0, 1.0 / 15.0);
    vec4 chemistry;
    vec4 combustion_dynamics;
    vec4 combustion_optical;
    transportCombustion(
        field_world_pos,
        field_segment_start,
        field_segment_end,
        neighbor_step_x,
        neighbor_step_y,
        neighbor_step_z,
        simulationDt,
        chemistry,
        combustion_dynamics,
        combustion_optical
    );
    imageStore(combustionState, coord, chemistry);
    imageStore(
        combustionDynamics,
        coord,
        combustion_dynamics
    );
    imageStore(combustionOptical, coord, combustion_optical);

    // View direction points FROM the sample point TOWARD the camera.
    vec3 view_dir = normalize(params.camera_pos.xyz - world_pos);

    // params.sun_dir.xyz points TO the sun; the light's propagation
    // (incoming) direction at the sample is the opposite, -sun_dir.
    vec3 light_in = -normalize(params.sun_dir.xyz);

    // HG phase: angle between light arrival direction and view direction.
    float cos_theta = dot(light_in, view_dir);
    float forwardPhase = henyey_greenstein(cos_theta, params.sun_dir.w);
    float backwardPhase = henyey_greenstein(cos_theta, params.medium_params.y);
    float phase = mix(
        backwardPhase,
        forwardPhase,
        clamp(params.medium_params.z, 0.0, 1.0)
    );

    // Procedural fog density — height falloff × 3D value noise around
    // the base scattering coefficient (see `proceduralDensityScale`).
    // REN-D16-01 / #2225 — anchor to the ground/floor near the camera
    // (params.fog_reference.x), not the camera's own eye height, so
    // density thins with real altitude instead of following the player.
    float density_scale = proceduralDensityScale(world_pos, params.fog_reference.x);
    float global_extinction = params.camera_pos.w * density_scale;
    LocalMedium local_medium = sampleLocalMedium(field_world_pos);
    LocalMedium transported_combustion = combustionMedium(
        chemistry,
        combustion_optical
    );
    bool transportedMediumActive = transported_combustion.extinction > 1.0e-7;
    accumulateCombustionLightMoment(
        coord,
        size,
        field_world_pos,
        fieldFrontT,
        fieldBackT,
        transported_combustion
    );
    float flame_source_sample_ratio = flameSourceSampleRatio(
        field_world_pos,
        world_pos
    );
    transported_combustion.extinction *= flame_source_sample_ratio;
    transported_combustion.scattering *= flame_source_sample_ratio;
    transported_combustion.emission *= flame_source_sample_ratio;
    local_medium.extinction += transported_combustion.extinction;
    local_medium.scattering += transported_combustion.scattering;
    local_medium.emission += transported_combustion.emission;
    float extinction_coef = global_extinction + local_medium.extinction;
    vec3 global_albedo = clamp(params.fog_tint.rgb, vec3(0.0), vec3(1.0))
        * clamp(params.medium_params.x, 0.0, 1.0);
    vec3 scattering_coef = global_extinction * global_albedo + local_medium.scattering;

    // CELL/WTHR fog colour is an apparent in-scattering colour, not merely a
    // hue for direct-light scattering. Treat it as the homogeneous medium's
    // equilibrium radiance: integration yields L_fog * (1 - T), the physical
    // exponential equivalent of Bethesda's legacy fog-colour blend. This
    // base source is essential indoors, where sun radiance is normally zero;
    // local and directional lights below add spatial structure on top.
    vec3 authored_inscatter = global_extinction
        * params.fog_tint.rgb * max(params.fog_tint.a, 0.0);

    // Phase 2c — visibility ray from sample point toward the sun.
    // Sun is directional (effectively at infinity), so:
    //   - origin = world_pos. No surface-normal bias needed; the
    //     sample is in volume space (potentially inside or outside
    //     geometry, but never lying on a surface), so a small tMin
    //     handles self-intersection trivially.
    //   - direction = sun_dir.xyz (points from sample toward sun; this
    //     is -light_in, since light_in is the light's propagation
    //     direction, not the direction toward its source — #1937).
    // If the opaque-mask ray hits anything, the sample is shadowed:
    // zero sun contribution. Otherwise the sun lights this voxel
    // through the medium, modulated by the phase function. This is
    // what produces god rays — voxels in a window's beam are lit,
    // voxels behind a wall are not, and the integration pass
    // propagates the boundary as crisp light shafts.
    //
    // Exterior vs interior take different strategies for the
    // no-opaque-hit case (see `render_origin.w` doc comment above and
    // `VolumetricsParams::render_origin` in `volumetrics.rs`):
    // exterior really does have open sky above, so no-hit genuinely
    // means lit. A `--cell`-loaded interior has no guaranteed
    // watertight shell — Bethesda authoring commonly omits ceiling
    // geometry entirely since players never see it from inside — so a
    // bare no-hit there just as often means "the ray escaped through a
    // missing ceiling," not "this froxel sees a real window." The
    // second, GLASS-only pass (bounded to the froxel volume's own far
    // plane — real windows are within the room, not out at the sun's
    // actual distance) disambiguates: a hit there means the ray
    // genuinely passed through window glass on its way out.
    vec3 ray_origin = world_pos;
    // Toward the sun, i.e. -light_in (light_in is the propagation
    // direction, away from the sun) — #1937.
    vec3 ray_dir = -light_in;
    float visibility;
    bool isExterior = params.render_origin.w > 0.5;
    bool opaqueHit = traceShadowBinary(
        ray_origin,
        ray_dir,
        0.05,
        DIRECTIONAL_SHADOW_TRACE_DISTANCE,
        VISIBILITY_MASK_ALL_OPAQUE
    );
    if (opaqueHit) {
        visibility = 0.0;
    } else if (isExterior) {
        visibility = 1.0;
    } else {
        bool sawGlass = traceShadowBinary(
            ray_origin, ray_dir, 0.05, params.volume_params.x, VISIBILITY_LAYER_GLASS
        );
        visibility = sawGlass ? 1.0 : 0.0;
    }
    if (transportedMediumActive && visibility > 1.0e-4) {
        visibility *= transportedCombustionTransmittance(
            world_pos,
            ray_dir,
            DIRECTIONAL_SHADOW_TRACE_DISTANCE,
            jitter.z
        );
    }

    // In-scattered radiance from the sun at this voxel, gated on
    // shadow visibility. HG normalisation already includes 1/4π.
    //
    // Thermal emission is added unconditionally: a flame radiates because it
    // is hot, not because anything illuminates it, so it is independent of
    // both the phase function and the shadow ray. This is the term that makes
    // a fire visible in a pitch-dark cell.
    vec3 inscatter = authored_inscatter
        + local_medium.emission
        + scattering_coef * phase * params.sun_color.rgb * visibility;

    // Phase 2b — point/spot light in-scattering, reusing the same cluster
    // grid as surface shading. Every local light admitted by the bounded loop
    // gets a real visibility ray: full-shadow sources query all opaque
    // geometry, while no-prop-shadow sources query the Architecture-only TLAS
    // mask. Letting the latter bypass visibility made fog glow through dungeon
    // walls even when surface lighting was corrected.
    {
        // Mirrors `getClusterIndex` (`include/clusters.glsl`) exactly,
        // so a froxel maps to the SAME cluster the fragment shader
        // would at this world distance — using `params.sun_color.a`
        // (the cell's fog-far, plumbed to match `screen.w`) as the
        // identical basis for the exponential depth-slice distribution.
        float clusterFar = params.sun_color.a > 1.0
            ? max(params.sun_color.a, CLUSTER_FAR_FLOOR)
            : CLUSTER_FAR_FALLBACK;
        float logRatio = log(clusterFar / CLUSTER_NEAR);
        uint tileX = min(uint(sampleUv.x * float(CLUSTER_TILES_X)), CLUSTER_TILES_X - 1u);
        uint tileY = min(uint(sampleUv.y * float(CLUSTER_TILES_Y)), CLUSTER_TILES_Y - 1u);
        uint sliceZ = uint(
            log(max(t, CLUSTER_NEAR) / CLUSTER_NEAR) / logRatio * float(CLUSTER_SLICES_Z)
        );
        sliceZ = min(sliceZ, CLUSTER_SLICES_Z - 1u);
        uint clusterIdx =
            tileX + tileY * CLUSTER_TILES_X + sliceZ * CLUSTER_TILES_X * CLUSTER_TILES_Y;

        const float ISOTROPIC_PHASE = 1.0 / (4.0 * PI);
        const uint MAX_FROXEL_LIGHTS = 8u;
        ClusterEntry cluster = clusters[clusterIdx];
        uint adaptiveLightCap = uint(clamp(
            floor(params.fog_reference.z + 0.5), 1.0, float(MAX_FROXEL_LIGHTS)));
        uint lightLoopCount = min(cluster.count, adaptiveLightCap);
        for (uint ci = 0u; ci < lightLoopCount; ++ci) {
            uint li = clusterLightIndices[cluster.offset + ci];
            float radius = lights[li].position_radius.w;
            float lightType = lights[li].color_type.w;
            // The sun path above already covers the environment's
            // directional source; this loop handles local lights.
            if (lightType > 1.5) {
                continue;
            }
            vec3 toLight = lights[li].position_radius.xyz - world_pos;
            float dist = length(toLight);
            vec3 toLightDir = toLight / max(dist, 0.001);
            float shape = lights[li].params.x;
            float atten = froxelLightAtten(
                dist,
                radius,
                shape > 0.0 ? shape : 1.0,
                lights[li].params.y,
                lights[li].params.w
            );
            if (lightType > 0.5) {
                // Spot — same cone factor as the fragment-shader loop.
                vec3 spotDir = normalize(lights[li].direction_angle.xyz);
                float spotAngle = lights[li].direction_angle.w;
                float spotFactor = dot(-toLightDir, spotDir);
                // #2205 — guard against a degenerate near-zero authored
                // outer angle (cos ≈ 1.0), matching giLightSample's
                // guard (lighting.glsl) now that spot lights are
                // actually reachable instead of silently downgraded to
                // point lights.
                atten *= clamp((spotFactor - spotAngle) / max(1.0 - spotAngle, 1e-4), 0.0, 1.0);
            }
            float localVisibility = 1.0;
            float shadowDist = max(dist - lights[li].params.y, 0.05);
            bool needsVisibility = visibilityMaskNeedsTrace(lights[li].params.z);
            if (needsVisibility && atten > 1.0e-4) {
                // Stop at the finite luminous shell (`params.y`) instead of
                // tracing into the middle of a bulb/flame and letting the
                // fixture nullify its own volumetric glow.
                uint opaqueMask = visibilityOpaqueMask(lights[li].params.z);
                if (traceShadowBinary(
                        world_pos, toLightDir, 0.05, shadowDist, opaqueMask)) {
                    localVisibility = 0.0;
                } else if (visibilityMaskUsesGlass(lights[li].params.z)
                    && traceShadowBinary(
                        world_pos, toLightDir, 0.05, shadowDist,
                        VISIBILITY_LAYER_GLASS)) {
                    // This pass does not bind the material/texture tables;
                    // use a conservative neutral interface transmission.
                    // Surface lighting performs full RGB glass transport.
                    localVisibility = 0.75;
                }
            }
            if (transportedMediumActive
                && localVisibility > 1.0e-4
                && atten > 1.0e-4) {
                localVisibility *= transportedCombustionTransmittance(
                    world_pos,
                    toLightDir,
                    shadowDist,
                    fract(jitter.z + float(ci) * 0.61803398875)
                );
            }
            inscatter += scattering_coef * ISOTROPIC_PHASE
                * lights[li].color_type.rgb * atten * localVisibility;
        }
    }

    vec4 current = vec4(inscatter, extinction_coef);
    float currentEmissionLuma = dot(local_medium.emission, LUMA_REC709);
    float currentSourceLuma = dot(current.rgb, LUMA_REC709);
    float currentEmissionFraction = clamp(
        currentEmissionLuma / max(currentSourceLuma, 1.0e-6),
        0.0,
        1.0
    );
    // Store the current share, not the temporally widened one. Otherwise a
    // single flash would feed its own history indefinitely instead of
    // decaying after one previous-frame interval.
    imageStore(emissionHistory, coord, vec4(currentEmissionFraction, 0.0, 0.0, 0.0));
    if (params.prev_camera_pos.w > 0.5) {
        vec3 previousUvw;
        if (reprojectHistory(world_pos, previousUvw)) {
            vec4 history = sampleHistoryColumn(previousUvw);
            float previousEmissionFraction = clamp(
                sampleEmissionHistoryColumn(previousUvw),
                0.0,
                1.0
            );
            float temporalEmissionFraction = max(
                currentEmissionFraction,
                previousEmissionFraction
            );
            float relativeDensityDelta = abs(history.a - current.a)
                / max(max(history.a, current.a), 1.0e-6);

            // Emissive media need a much shorter temporal time constant than
            // atmospheric fog. At the 0.92 steady-state weight a muzzle
            // flash or an explosion's leading edge smears across roughly a
            // dozen frames, and even ordinary flame flicker turns to mush.
            //
            // This is deliberately NOT implemented as a rejection on radiance
            // delta, which is the obvious approach and is wrong here: the sun
            // visibility test is a single jittered BINARY sample, so it
            // legitimately flips between frames at every shadow boundary.
            // Rejecting on that delta would suppress accumulation exactly at
            // the god-ray edges accumulation was added to clean up, undoing
            // M-LIGHT v2. Emission carries no such stochastic term — it is
            // deterministic given the volume — so keying the shorter time
            // constant on how much of the source term is emissive isolates
            // the fast-changing signal without touching the noisy one.
            // #2809 (REN-D16-04): the dedicated scalar history image makes
            // the short emissive time constant symmetric. A leading edge is
            // keyed by the current share; a trailing edge is keyed by the
            // reprojected previous share. It intentionally stores only source
            // provenance, never radiance, so the stochastic binary sun ray
            // remains governed by the steady atmospheric history path.
            float steadyWeight = clamp(params.temporal_params.x, 0.0, 0.98);
            float emissiveWeight = clamp(params.fog_reference.y, 0.0, 0.98);
            float relativeRadianceDelta = dot(abs(history.rgb - current.rgb), LUMA_REC709)
                / max(max(dot(history.rgb, LUMA_REC709), currentSourceLuma), 1.0e-5);
            float emissionAgreement = exp(
                -2.5 * relativeRadianceDelta * temporalEmissionFraction);
            float historyWeight =
                mix(steadyWeight, emissiveWeight, temporalEmissionFraction)
                * exp(-params.temporal_params.y * relativeDensityDelta)
                * emissionAgreement;
            current = mix(current, history, historyWeight);
        }
    }

    imageStore(froxel, coord, current);
}
