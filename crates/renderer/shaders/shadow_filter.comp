#version 450
#extension GL_GOOGLE_include_directive : require

#include "include/shader_constants.glsl"
#include "include/mesh_id.glsl"
#include "include/oct_codec.glsl"

// Direct-shadow spatial filter (penumbra-aware, PAF-001..009 in
// docs/engine/penumbra-aware-shadow-filter.md): an edge-aware 5x5 B3 a-trous chain over the
// per-pixel ReSTIR shadow ratio (`accum`, the Heitz-2018 ratio the direct
// term is shaded by: Lo += U * accum). The ratio EMA filters shadows
// temporally only; with the camera moving it runs at a 16-frame / 0.1-floor
// tail, so penumbrae boiled in motion with no spatial filter behind them.
//
// Only the shadow ratio is filtered — never U (the unshadowed BRDF sum), so
// texture and highlight detail is untouched. The last iteration writes the
// correction U * (filtered - raw), which composite adds to direct light; an
// absent or failed pass leaves composite exactly as before.
//
// Guides come from the claim winner's reservoir: geometric normal (pad0),
// view-ray distance (histLenAndDepth.y), validity (a zero history length is
// a zero-filled slot nothing claimed this frame). Edge stops: normal power,
// distance against the local slope, and the ratio difference.
//
// #6249 — validity also requires the slot's owner to be the VISIBLE
// surface: the claimant is whichever lit fragment won the atomicMin, but
// unlit screens, alpha-tested blades, glass and blended decals never claim,
// so the surface behind them owns the slot while the pixel shows something
// else. `slotOwnsVisiblePixel` compares the G-buffer mesh ID (bit 31 set on
// blended draws, low bits = the stable surface ID otherwise) against the
// reservoir's surface tag, the same identity the claim packed. That also
// rejects torn claim/store pairs whose reservoir came from a different
// surface than the depth winner. Water keeps the floor's correction: it
// writes no mesh ID, so the attachment still names the claimant.

layout(local_size_x = WORKGROUP_X, local_size_y = WORKGROUP_Y, local_size_z = 1) in;

// std430 mirror of `struct Reservoir` in include/bindings.glsl (36 B).
// `reservoir_glsl_copies_stay_in_lockstep` pins the two copies (#6317).
struct Reservoir {
    uint  lightAndSurface;
    float W;
    float M;
    float histLenAndDepth;
    float accumR;
    float accumG;
    float accumB;
    float pad0;
    uint  occluderSurface;
};

layout(std430, set = 0, binding = 0) readonly buffer ReservoirBuffer {
    Reservoir reservoirs[];
};
layout(std430, set = 0, binding = 1) readonly buffer UnshadowedBuffer {
    uvec2 unshadowed[];
};
layout(set = 0, binding = 2, rgba16f) uniform image2D ratioA;
layout(set = 0, binding = 3, rgba16f) uniform image2D ratioB;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outDelta;
// #6249 — the G-buffer mesh-ID attachment (R32_UINT), already in
// SHADER_READ_ONLY_OPTIMAL after the main pass (SVGF samples it the same
// way one dispatch earlier). Point-sampled: exact texel identity, no filter.
layout(set = 0, binding = 5) uniform highp usampler2D meshIdTex;

layout(push_constant) uniform Push {
    uvec2 screen;
    uint step;
    // bit 0: read the raw ratio from the reservoirs (first iteration);
    // bit 1: the source image is ratioB (else ratioA);
    // bit 2: last iteration (write the correction, not a ratio image).
    uint flags;
    // World units one pixel spans per unit of view distance, 2 tan(fov_y/2) / H
    // (PAF section 3.2). 0 disables the penumbra radius: every pixel then
    // uses the chain's full reach, which is the pre-PAF behaviour.
    float pixelAngle;
    // The chain's reach in pixels at this frame's iteration count (PAF-003's
    // R_max) = 2 * (2^iterations - 1).
    float reachMax;
} pc;

// The PAF-003 / PAF-005 constants (minimum radius, radius scale, blocker search
// window) are SHADOW_FILTER_RADIUS_MIN, SHADOW_FILTER_PENUMBRA_RADIUS_SCALE and
// SHADOW_FILTER_SEARCH_HALF / _STRIDE in shader_constants_data.rs.

struct ShadowFilterGuide {
    bool valid;
    float dist;
    float histLen;
    vec3 normal;
};

// #6249 — is `q`'s reservoir slot owned by the surface `q` actually shows?
// The claim packs its stable surface ID in `lightAndSurface`'s high bits
// (`RESERVOIR_SURFACE_MASK`-wide, same helper as triangle.frag's
// `reservoirSurfaceId`); the mesh-ID attachment carries the depth winner's
// stable ID, or bit 31 + an alpha draw index for blended draws. A match
// means the correction lands on the surface it was computed for; anything
// else (unlit screen over a lit wall, blade over terrain, glass, decal,
// torn slot) must not be filtered or used as a neighbour guide.
bool slotOwnsVisiblePixel(ivec2 q, uint lightAndSurface) {
    uint visible = texelFetch(meshIdTex, q, 0).r;
    return meshIdHasStableHistory(visible)
        && (visible & RESERVOIR_SURFACE_MASK) == (lightAndSurface >> RESERVOIR_LIGHT_BITS);
}

ShadowFilterGuide guideAt(ivec2 q) {
    Reservoir r = reservoirs[uint(q.y) * pc.screen.x + uint(q.x)];
    vec2 histDepth = unpackHalf2x16(floatBitsToUint(r.histLenAndDepth));
    ShadowFilterGuide g;
    g.valid = histDepth.x != 0.0 && !isnan(histDepth.x)
        && slotOwnsVisiblePixel(q, r.lightAndSurface);
    g.dist = histDepth.y;
    g.histLen = abs(histDepth.x);
    g.normal = octDecode(unpackSnorm2x16(floatBitsToUint(r.pad0)));
    return g;
}

vec3 rawRatioAt(ivec2 q) {
    Reservoir r = reservoirs[uint(q.y) * pc.screen.x + uint(q.x)];
    vec3 ratio = vec3(r.accumR, r.accumG, r.accumB);
    return any(isnan(ratio)) || any(isinf(ratio)) ? vec3(0.0) : max(ratio, vec3(0.0));
}

vec3 sourceRatioAt(ivec2 q) {
    if ((pc.flags & 1u) != 0u) {
        return rawRatioAt(q);
    }
    return ((pc.flags & 2u) != 0u ? imageLoad(ratioB, q) : imageLoad(ratioA, q)).rgb;
}

float sourceRadiusAt(ivec2 q) {
    return ((pc.flags & 2u) != 0u ? imageLoad(ratioB, q) : imageLoad(ratioA, q)).a;
}

bool inScreen(ivec2 q) {
    return q.x >= 0 && q.y >= 0 && q.x < int(pc.screen.x) && q.y < int(pc.screen.y);
}

// PAF-001: this pixel's penumbra width in world units, an f16 in the high half
// of `directUnshadowed[].y` (triangle.frag writes it; 0 = lit or no ray).
float penumbraWidthAt(ivec2 q) {
    return unpackHalf2x16(unshadowed[uint(q.y) * pc.screen.x + uint(q.x)].y).y;
}

// PAF-005: Fernando's blocker search, in screen space. Averages the width over
// the valid, surface-owning neighbours that saw an occluder this frame,
// weighted by the normal and distance edge stops, and projects it to a kernel
// radius in pixels (PAF section 3.2: R = w / 2f, f = view distance * pixelAngle).
// A pixel with no neighbour reporting a width is outside every penumbra and
// gets SHADOW_FILTER_RADIUS_MIN.
float penumbraRadius(ivec2 p, ShadowFilterGuide gp, float slope) {
    if (pc.pixelAngle <= 0.0) return pc.reachMax;
    float sum = 0.0;
    float wSum = 0.0;
    for (int dy = -int(SHADOW_FILTER_SEARCH_HALF); dy <= int(SHADOW_FILTER_SEARCH_HALF); dy++) {
        for (int dx = -int(SHADOW_FILTER_SEARCH_HALF); dx <= int(SHADOW_FILTER_SEARCH_HALF); dx++) {
            ivec2 q = p + ivec2(dx, dy) * int(SHADOW_FILTER_SEARCH_STRIDE);
            if (!inScreen(q)) continue;
            float width = penumbraWidthAt(q);
            if (!(width > 0.0)) continue;
            ShadowFilterGuide gq = guideAt(q);
            if (!gq.valid) continue;
            float wN = pow(max(dot(gp.normal, gq.normal), 0.0), SHADOW_FILTER_NORMAL_POWER);
            float expected = slope * length(vec2(dx, dy)) * float(SHADOW_FILTER_SEARCH_STRIDE);
            float wZ = exp(-abs(gq.dist - gp.dist)
                / (SHADOW_FILTER_DEPTH_SLOPE_SCALE * expected + 0.5
                   + SHADOW_FILTER_DEPTH_REL_TOL * gp.dist));
            float w = wN * wZ;
            sum += w * width;
            wSum += w;
        }
    }
    if (wSum <= 1e-6) return SHADOW_FILTER_RADIUS_MIN;
    float footprint = max(gp.dist * pc.pixelAngle, 1e-6);
    return clamp(SHADOW_FILTER_PENUMBRA_RADIUS_SCALE * sum / wSum / (2.0 * footprint), SHADOW_FILTER_RADIUS_MIN, pc.reachMax);
}

void storeResult(ivec2 p, vec3 filtered, vec3 raw, uint idx, float strength, float radius) {
    if ((pc.flags & 4u) != 0u) {
        uvec2 packedU = unshadowed[idx];
        vec3 U = vec3(unpackHalf2x16(packedU.x), unpackHalf2x16(packedU.y).x);
        imageStore(outDelta, p, vec4(U * strength * (filtered - raw), 0.0));
    } else if ((pc.flags & 2u) != 0u) {
        imageStore(ratioA, p, vec4(filtered, radius));
    } else {
        imageStore(ratioB, p, vec4(filtered, radius));
    }
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inScreen(p)) return;
    uint idx = uint(p.y) * pc.screen.x + uint(p.x);

    ShadowFilterGuide gp = guideAt(p);
    if (!gp.valid) {
        // Nothing claimed this pixel (sky, blend-only, unlit), or the slot's
        // owner is not the visible surface (#6249): no ratio to filter and
        // nothing for composite to correct.
        storeResult(p, vec3(0.0), vec3(0.0), idx, 0.0, SHADOW_FILTER_RADIUS_MIN);
        return;
    }
    vec3 raw = rawRatioAt(p);
    vec3 cP = sourceRatioAt(p);

    // Local distance slope per pixel, from the nearest valid same-plane
    // neighbours: a grazing floor changes view-ray distance by many units
    // per pixel, a facing wall by almost none.
    float slope = 0.0;
    for (int a = 0; a < 2; a++) {
        ivec2 q = p + (a == 0 ? ivec2(1, 0) : ivec2(0, 1));
        if (!inScreen(q)) q = p - (a == 0 ? ivec2(1, 0) : ivec2(0, 1));
        if (!inScreen(q)) continue;
        ShadowFilterGuide gq = guideAt(q);
        if (gq.valid && dot(gq.normal, gp.normal) > 0.9) {
            slope = max(slope, abs(gq.dist - gp.dist));
        }
    }

    // The kernel radius is decided once, in the first iteration, and carried
    // in the ratio images' alpha channel (the blocker search reads only this
    // frame's width, so it never changes between iterations).
    float radius = (pc.flags & 1u) != 0u ? penumbraRadius(p, gp, slope) : sourceRadiusAt(p);
    // PAF-008: an iteration whose stride exceeds R passes the pixel through, so
    // a narrow penumbra stops early and a wide one uses the whole chain.
    if (float(pc.step) > radius) {
        float strengthPass = clamp(SHADOW_FILTER_CONFIDENT_HISTORY / max(gp.histLen, 1.0), 0.0, 1.0);
        storeResult(p, cP, raw, idx, strengthPass, radius);
        return;
    }
    // PAF-008: a Gaussian over the tap's screen offset, sigma = R / 2.
    float invTwoSigmaSq = 1.0 / (0.5 * radius * radius);

    const float h[3] = float[3](0.375, 0.25, 0.0625);
    vec3 sum = vec3(0.0);
    float wSum = 0.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 q = p + ivec2(dx, dy) * int(pc.step);
            if (!inScreen(q)) continue;
            ShadowFilterGuide gq = guideAt(q);
            if (!gq.valid) continue;
            float wN = pow(max(dot(gp.normal, gq.normal), 0.0), SHADOW_FILTER_NORMAL_POWER);
            float expected = slope * length(vec2(dx, dy)) * float(pc.step);
            float wZ = exp(-abs(gq.dist - gp.dist)
                / (SHADOW_FILTER_DEPTH_SLOPE_SCALE * expected + 0.5
                   + SHADOW_FILTER_DEPTH_REL_TOL * gp.dist));
            vec3 cQ = sourceRatioAt(q);
            vec3 dC = abs(cQ - cP);
            float wR = exp(-max(max(dC.r, dC.g), dC.b) / SHADOW_FILTER_RATIO_SIGMA);
            vec2 offsetPx = vec2(dx, dy) * float(pc.step);
            float wG = pc.pixelAngle > 0.0 ? exp(-dot(offsetPx, offsetPx) * invTwoSigmaSq) : 1.0;
            float w = h[abs(dx)] * h[abs(dy)] * wN * wZ * wR * wG;
            sum += w * cQ;
            wSum += w;
        }
    }
    vec3 filtered = wSum > 1e-6 ? sum / wSum : cP;
    // Confidence: a long-converged ratio needs no spatial filtering.
    float strength = clamp(SHADOW_FILTER_CONFIDENT_HISTORY / max(gp.histLen, 1.0), 0.0, 1.0);
    storeResult(p, filtered, raw, idx, strength, radius);
}
