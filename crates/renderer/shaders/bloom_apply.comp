// #2796 / REN-D16-01 — bloom-apply pass.
//
// Bloom's downsample/upsample chain (bloom_downsample.comp /
// bloom_upsample.comp) now runs AFTER `composite.frag` instead of before
// it, reading composite's own assembled scene (sky + demodulated GI +
// caustics + direct, everything composite.frag adds) rather than the raw
// pre-composite HDR attachment, which never contained sky/GI/caustics —
// those only ever existed inside composite.frag's own `combined`
// accumulator. Without this move the bloom pyramid was permanently blind
// to the brightest content in the scene (the sun disc, sky highlights),
// and its structural DC gain amplified whatever the exterior HDR clear
// colour happened to be at every untouched sky texel.
//
// This shader is the missing other half of that move: composite.frag no
// longer folds bloom into `combined` itself (it can't — bloom hasn't been
// computed yet when composite runs under the new order), so this pass
// reads the composed scene BACK as a storage image, adds bloom on top,
// and writes it back in place. `scene_image` therefore goes through one
// extra SHADER_READ_ONLY_OPTIMAL -> GENERAL -> SHADER_READ_ONLY_OPTIMAL
// round trip per frame — see the two boundary barriers around this
// dispatch in `bloom.rs::apply_to_scene` and `descriptors.rs`'s
// `image_barrier_shader_read_to_general` / `_general_to_shader_read`.
#version 450
#extension GL_GOOGLE_include_directive : require

// Shared constants — generated by crates/renderer/build.rs.
#include "include/shader_constants.glsl"

layout(local_size_x = WORKGROUP_X, local_size_y = WORKGROUP_Y) in;

// Composite's assembled render-resolution linear-HDR scene
// (`composite.scene_images[frame]`), read-modify-written in place.
// Alpha is `direct4.a` (the transparent-coverage marker bit, #2466 /
// DEN-11) and must pass through unchanged — bloom only ever adds to RGB.
layout(set = 0, binding = 0, rgba16f) uniform image2D sceneImage;

// Bloom's final (mip 0) up-pyramid result — half-screen resolution;
// hardware bilinear filtering upscales it to full screen for free. Same
// sampling convention `composite.frag` used before this moved here.
layout(set = 0, binding = 1) uniform sampler2D bloomTex;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(sceneImage);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec4 scene = imageLoad(sceneImage, coord);
    vec3 bloom = texture(bloomTex, uv).rgb;
    imageStore(sceneImage, coord, vec4(scene.rgb + bloom * BLOOM_INTENSITY, scene.a));
}
