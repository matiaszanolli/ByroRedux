// M55 Phase 3 — Volumetric ray-march integration.
//
// One thread per froxel (x, y) column. The thread walks slices
// 0 → FROXEL_DEPTH-1 sequentially, accumulating the standard
// volumetric integration recurrence (Hillaire, "Physically Based
// and Unified Volumetric Rendering in Frostbite," SIGGRAPH 2015,
// §5.3 — Light Scattering Integration):
//
//   per slab i (thickness dt, homogeneous coefficients):
//     T_slab = exp(-extinction[i] * dt)
//     source_integral = (1 - T_slab) / extinction[i]
//     integrated_inscatter += inscatter[i] * T_cum * source_integral
//     T_cum *= T_slab
//     write (integrated_inscatter, T_cum) at slice i
//
// dt is derived per slice from the hybrid linear/exponential depth
// distribution below, so every slab uses its exact view-space width.
//
// The output volume stores per-slice cumulative state, so composite
// reads a single sampler3D tap at `slice = worldDist / VOLUME_FAR`
// and gets the integrated radiance + transmittance for that pixel —
// no per-fragment ray-march, no double-fog stacking, O(screen) cost
// instead of O(screen × steps).
//
// This is the math identity transposition of the per-fragment march
// that shipped in Phase 4 — same recurrence, hoisted to a compute
// pass so we run it 32 400 times per frame at 1080p with the default
// froxel_xy_divisor=8 grid (one per froxel column)
// instead of 2 073 600 times (one per 1080p pixel).
#version 460
#extension GL_GOOGLE_include_directive : require

// Shared constants — generated by crates/renderer/build.rs.
#include "include/shader_constants.glsl"

layout(local_size_x = WORKGROUP_X, local_size_y = WORKGROUP_Y, local_size_z = 1) in;

// Read: per-froxel inscatter + extinction written by the injection pass.
layout(set = 0, binding = 0, rgba16f) uniform readonly image3D injection;
// Write: per-slice cumulative (integrated_inscatter, total_transmittance).
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D integrated;

layout(set = 0, binding = 2) uniform IntegrationParams {
    // x = grid far, y = linear-depth floor, z = fraction of slices assigned
    // to the linear region, w = slice count. Distances are world units.
    vec4 grid;
} params;

float sliceDistance(float normalizedSlice) {
    float u = clamp(normalizedSlice, 0.0, 1.0);
    float farDistance = max(params.grid.x, 1.0);
    float linearDepth = clamp(params.grid.y, 1.0, farDistance);
    float linearFraction = clamp(params.grid.z, 1.0e-4, 0.9999);
    if (u <= linearFraction) {
        return linearDepth * (u / linearFraction);
    }
    float q = (u - linearFraction) / (1.0 - linearFraction);
    return linearDepth * pow(farDistance / linearDepth, q);
}

void main() {
    ivec3 size = imageSize(injection);
    ivec2 col = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(col, size.xy))) {
        return;
    }

    vec3 inscatter_total = vec3(0.0);
    float trans_cumulative = 1.0;

    for (int slice = 0; slice < size.z; ++slice) {
        float sliceFront = float(slice) / float(size.z);
        float sliceBack = float(slice + 1) / float(size.z);
        float dt = sliceDistance(sliceBack) - sliceDistance(sliceFront);
        // Each XY column represents one camera ray. Never average injection
        // from adjacent columns here: those rays can lie on opposite sides of
        // an opaque wall or window frame, and an unconditional spatial blur
        // turns a correctly shadowed froxel into light leaking through that
        // structure. Edge reconstruction belongs in a geometry-aware upscale,
        // not in the physical integration recurrence.
        vec4 inj = imageLoad(injection, ivec3(col, slice));
        vec3 inscatter = inj.rgb;
        float extinction = inj.a;

        // Injection evaluates one jittered set of homogeneous coefficients
        // inside this exact hybrid-Z slab. Integrate the source term against
        // Beer-Lambert attenuation analytically:
        //
        //   integral_0^dt exp(-sigma_t*s) ds
        //     = (1 - exp(-sigma_t*dt)) / sigma_t.
        //
        // The prior rectangle rule (`source * dt`) grows without bound for a
        // dense slab and turns thick smoke brighter than its equilibrium
        // radiance. The closed form saturates as optical depth grows. Use the
        // first two terms of the series near zero to avoid cancellation while
        // retaining the vacuum limit exactly. #2241 (REN-D16-03).
        float sigmaT = max(extinction, 0.0);
        float opticalDepth = sigmaT * dt;
        float slabTransmittance = exp(-opticalDepth);
        float sourceIntegral = opticalDepth < 1.0e-3
            ? dt * (1.0 - 0.5 * opticalDepth)
            : (1.0 - slabTransmittance) / sigmaT;
        inscatter_total += inscatter * trans_cumulative * sourceIntegral;
        trans_cumulative *= slabTransmittance;

        imageStore(
            integrated,
            ivec3(col, slice),
            vec4(inscatter_total, trans_cumulative)
        );
    }
}
