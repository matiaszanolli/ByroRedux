package byro:mod-host@0.1.0;

/// Attributed, bounded diagnostics emitted by an executable mod.
interface logging {
    enum level {
        debug,
        info,
        warn,
        error,
    }

    log: func(level: level, message: string);
}

/// Read-only facts about the current sandbox principal.
interface context {
    principal-id: func() -> string;
    has-capability: func(capability: string) -> bool;
    sdk-version: func() -> string;
    service-version: func(service: string) -> option<string>;
}

/// Deferred mutations to principal-owned extension component state.
interface state {
    record entity-ref {
        world-generation: u64,
        object: u64,
    }

    record form-ref {
        source-high: u64,
        source-low: u64,
        local: u32,
    }

    record hit-details {
        damage: f32,
        power-attack: bool,
        sneak-attack: bool,
        bash-attack: bool,
        blocked: bool,
    }

    enum input-action {
        move-forward,
        move-backward,
        strafe-left,
        strafe-right,
        jump,
        sprint,
        activate,
        attack,
        block,
        inventory,
        quicksave,
        quickload,
        pause,
    }

    enum input-phase {
        pressed,
        released,
    }

    enum session-phase {
        new-game,
        save-complete,
        load-complete,
    }

    /// Queue one checked increment. Schema and field indices refer to the
    /// ordered tables in the authenticated package manifest.
    queue-increment-own-i64: func(
        entity: entity-ref,
        schema-index: u32,
        field-index: u32,
        delta: s64,
    );
}

/// Principal-scoped persistent data stored inside the engine save.
interface storage {
    variant value {
        boolean(bool),
        signed(s64),
        unsigned(u64),
        text(string),
        bytes(list<u8>),
    }

    schema-version: func() -> option<u32>;
    get: func(key: string) -> option<value>;
    queue-set: func(key: string, value: value);
    queue-delete: func(key: string);
    queue-increment-i64: func(key: string, delta: s64);
}

/// Immutable facts about live entities already disclosed to this callback.
interface world-state {
    use state.{entity-ref, form-ref};

    record vec3 {
        x: f32,
        y: f32,
        z: f32,
    }

    record quat {
        x: f32,
        y: f32,
        z: f32,
        w: f32,
    }

    record world-transform {
        translation: vec3,
        rotation: quat,
        scale: f32,
    }

    record entity-projection {
        entity: entity-ref,
        form: option<form-ref>,
        name: option<string>,
        world-transform: option<world-transform>,
    }

    contains-entity: func(entity: entity-ref) -> bool;
    get-entity: func(entity: entity-ref) -> option<entity-projection>;
}

/// Minimal lifecycle contract for the first executable-mod runtime slice.
world extension {
    import logging;
    import context;
    import state;
    import storage;
    import world-state;

    use state.{entity-ref, form-ref, hit-details, input-action, input-phase, session-phase};

    export initialize: func();
    export on-activate: func(subject: entity-ref, activator: option<entity-ref>);
    export on-cell-load: func(subject: entity-ref);
    export on-hit: func(
        subject: entity-ref,
        aggressor: option<entity-ref>,
        source: option<entity-ref>,
        projectile: option<entity-ref>,
        details: hit-details,
    );
    export on-equipment-change: func(
        wearer: entity-ref,
        item: form-ref,
        equipped: bool,
    );
    export on-input-action: func(action: input-action, phase: input-phase);
    export on-session-event: func(phase: session-phase, slot: option<u32>);
    export on-update: func(elapsed-seconds: f32);
    export shutdown: func();
}
