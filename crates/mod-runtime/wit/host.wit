package byro:mod-host@0.1.0;

/// Attributed, bounded diagnostics emitted by an executable mod.
interface logging {
    enum level {
        debug,
        info,
        warn,
        error,
    }

    log: func(level: level, message: string);
}

/// Read-only facts about the current sandbox principal.
interface context {
    variant setting-value {
        boolean(bool),
        number(f32),
        choice(string),
    }

    principal-id: func() -> string;
    has-capability: func(capability: string) -> bool;
    sdk-version: func() -> string;
    service-version: func(service: string) -> option<string>;
    engine-setting: func(key: string) -> option<setting-value>;
    queue-own-setting: func(declaration-index: u32, value: setting-value);
}

/// Capability-gated, bounded custom/mod event publication and callback-local
/// payload access. Native channels remain principal-owned; reserved legacy
/// compatibility channels are shared and engine-owned. The callback receives
/// the exact manifest subscription index, so channels never become
/// guest-chosen numeric identifiers.
interface events {
    use state.{form-ref};

    publish: func(event: string, payload: list<u8>);
    legacy-builder-create: func(event-name: string) -> u32;
    legacy-builder-push-bool: func(handle: u32, value: bool);
    legacy-builder-push-int: func(handle: u32, value: s32);
    legacy-builder-push-float: func(handle: u32, value: f32);
    legacy-builder-push-string: func(handle: u32, value: string);
    legacy-builder-push-form: func(handle: u32, value: option<form-ref>);
    legacy-builder-send: func(handle: u32) -> bool;
    legacy-builder-release: func(handle: u32);
    /// Queue an SKSE-compatible runtime registration. Registrations are
    /// transient by design and must be refreshed after load, matching SKSE.
    queue-legacy-subscribe: func(event-name: string, callback: string);
    queue-legacy-unsubscribe: func(event-name: string);
    queue-legacy-unsubscribe-all: func();
    /// Callback identifier registered for the event currently being delivered.
    current-legacy-callback: func() -> option<string>;
    current-payload-len: func() -> u32;
    current-payload-byte: func(index: u32) -> option<u8>;
}

/// Deferred mutations to principal-owned extension component state.
interface state {
    record entity-ref {
        world-generation: u64,
        object: u64,
    }

    record form-ref {
        source-high: u64,
        source-low: u64,
        local: u32,
    }

    record hit-details {
        damage: f32,
        power-attack: bool,
        sneak-attack: bool,
        bash-attack: bool,
        blocked: bool,
    }

    enum input-action {
        move-forward,
        move-backward,
        strafe-left,
        strafe-right,
        jump,
        sprint,
        activate,
        attack,
        block,
        inventory,
        quicksave,
        quickload,
        pause,
    }

    enum input-phase {
        pressed,
        released,
    }

    enum session-phase {
        new-game,
        save-complete,
        load-complete,
    }

    /// Queue one checked increment. Schema and field indices refer to the
    /// ordered tables in the authenticated package manifest.
    queue-increment-own-i64: func(
        entity: entity-ref,
        schema-index: u32,
        field-index: u32,
        delta: s64,
    );
}

/// Principal-local typed object handles used by the JContainers source
/// compatibility adapter. Objects are bounded and included in engine saves.
interface legacy-containers {
    use state.{form-ref};

    variant value {
        int(s32),
        float(f32),
        text(string),
        form(option<form-ref>),
        object(s32),
    }

    array-create: func() -> s32;
    map-create: func() -> s32;
    count: func(handle: s32) -> s32;
    clear: func(handle: s32) -> bool;
    release: func(handle: s32) -> bool;
    array-add: func(handle: s32, value: value, index: option<u32>) -> bool;
    array-get: func(handle: s32, index: s32) -> option<value>;
    array-set: func(handle: s32, index: s32, value: value) -> bool;
    array-erase: func(handle: s32, index: s32) -> bool;
    map-get: func(handle: s32, key: string) -> option<value>;
    map-has-key: func(handle: s32, key: string) -> bool;
    map-set: func(handle: s32, key: string, value: value) -> bool;
    map-remove: func(handle: s32, key: string) -> bool;
}

/// Principal-scoped persistent data stored inside the engine save.
interface storage {
    variant value {
        boolean(bool),
        signed(s64),
        unsigned(u64),
        text(string),
        bytes(list<u8>),
    }

    enum collection-kind {
        array,
        associative-map,
        set,
    }

    schema-version: func() -> option<u32>;
    get: func(key: string) -> option<value>;
    /// Queue an atomic post-callback mutation. Accepted scalar mutations are
    /// immediately reflected by reads in the current callback's transaction
    /// overlay; a callback trap discards the queued mutation.
    queue-set: func(key: string, value: value);
    queue-delete: func(key: string);
    queue-increment-i64: func(key: string, delta: s64);
    get-collection-kind: func(key: string) -> option<collection-kind>;
    collection-len: func(key: string) -> option<u32>;
    array-get: func(key: string, index: u32) -> option<value>;
    queue-array-push: func(key: string, value: value);
    queue-array-set: func(key: string, index: u32, value: value);
    queue-array-remove: func(key: string, index: u32);
    map-get: func(key: string, entry: string) -> option<value>;
    queue-map-set: func(key: string, entry: string, value: value);
    queue-map-delete: func(key: string, entry: string);
    set-contains: func(key: string, value: value) -> bool;
    queue-set-insert: func(key: string, value: value);
    queue-set-remove: func(key: string, value: value);
}

/// Immutable facts about live entities already disclosed to this callback.
interface world-state {
    use state.{entity-ref, form-ref};

    record vec3 {
        x: f32,
        y: f32,
        z: f32,
    }

    record quat {
        x: f32,
        y: f32,
        z: f32,
        w: f32,
    }

    record world-transform {
        translation: vec3,
        rotation: quat,
        scale: f32,
    }

    record entity-projection {
        entity: entity-ref,
        form: option<form-ref>,
        name: option<string>,
        world-transform: option<world-transform>,
    }

    contains-entity: func(entity: entity-ref) -> bool;
    get-entity: func(entity: entity-ref) -> option<entity-projection>;
}

/// Read-only active game-content catalog. Numeric positions are only catalog
/// ordinals; authored forms are always returned as portable source/local IDs.
interface content-catalog {
    use state.{form-ref};

    enum plugin-kind {
        regular,
        light,
    }

    record plugin-info {
        name: string,
        source-high: u64,
        source-low: u64,
        kind: plugin-kind,
    }

    record record-info {
        // Four ASCII signature bytes packed in network order (for example WEAP).
        record-type: u32,
    }

    plugin-count: func() -> u32;
    plugin-at: func(index: u32) -> option<plugin-info>;
    find-plugin: func(name: string) -> option<u32>;
    dependency-count: func(plugin: u32) -> option<u32>;
    dependency-at: func(plugin: u32, index: u32) -> option<u32>;
    get-record: func(form: form-ref) -> option<record-info>;
    qualify-form: func(plugin: string, local: u32) -> option<form-ref>;
}

/// Callback-local canonical actor values. Mutations are deferred until after
/// guest execution and use portable AVIF identities.
interface actor-values {
    use state.{entity-ref, form-ref};

    record actor-value-state {
        base: f32,
        permanent: f32,
        temporary: f32,
        damage: f32,
        current: f32,
    }

    enum operation {
        set-base,
        modify-permanent,
        modify-temporary,
        damage,
        restore,
    }

    get: func(entity: entity-ref, actor-value: form-ref) -> option<actor-value-state>;
    queue: func(entity: entity-ref, actor-value: form-ref, operation: operation, value: f32);
}

/// Callback-local inventory summaries aggregated by portable base form.
/// Per-instance mutation is intentionally not part of this read-only slice.
interface inventory {
    use state.{entity-ref, form-ref};

    enum item-category {
        misc,
        junk,
        mod,
        book,
        note,
        ingredient,
        aid,
        key,
        ammo,
        armor,
        weapon,
    }

    record item-metadata {
        name: string,
        category: item-category,
        value: u32,
        weight: f32,
    }

    record inventory-entry {
        item: form-ref,
        count: u64,
        biped-slots: u32,
        weapon-equipped: bool,
        metadata: option<item-metadata>,
    }

    record inventory-snapshot {
        entries: list<inventory-entry>,
        truncated: bool,
    }

    get: func(entity: entity-ref) -> option<inventory-snapshot>;
}

/// Callback-local faction membership ranks keyed by portable FACT identity.
interface factions {
    use state.{entity-ref, form-ref};

    record faction-membership {
        faction: form-ref,
        rank: s8,
    }

    record faction-snapshot {
        memberships: list<faction-membership>,
        truncated: bool,
    }

    get: func(entity: entity-ref) -> option<faction-snapshot>;
}

/// Directional authored FACT relationship data from the resolved load order.
interface faction-relationships {
    use state.{form-ref};

    record faction-relationship {
        modifier: s32,
        combat-reaction: u32,
    }

    get: func(source: form-ref, target: form-ref) -> option<faction-relationship>;
    truncated: func() -> bool;
}

/// Callback-local owned perk ranks keyed by portable PERK identity.
interface perks {
    use state.{entity-ref, form-ref};

    record perk-entry {
        perk: form-ref,
        rank: u8,
    }

    record perk-snapshot {
        entries: list<perk-entry>,
        truncated: bool,
    }

    get: func(entity: entity-ref) -> option<perk-snapshot>;
}

/// Live ambient and scene package selections plus semantic reevaluation.
interface packages {
    use state.{entity-ref, form-ref};

    enum selection-source {
        ambient,
        scene,
    }

    record package-selection {
        source: selection-source,
        scene: option<form-ref>,
        action-index: option<u32>,
        candidates: list<form-ref>,
        active: option<form-ref>,
        template: option<form-ref>,
    }

    record package-snapshot {
        selections: list<package-selection>,
        truncated: bool,
    }

    get: func(entity: entity-ref) -> option<package-snapshot>;
    queue-evaluate: func(entity: entity-ref);
}

/// Authored actor animation state and semantic IDLE playback requests.
interface animation {
    use state.{entity-ref, form-ref};

    enum animation-event {
        play-imod,
        idle-furniture-exit,
        exit-cart-end,
    }

    record animation-snapshot {
        requested-idle: option<form-ref>,
        request-generation: u64,
        awaited-event: option<animation-event>,
        last-event: option<animation-event>,
        event-generation: u64,
    }

    get: func(entity: entity-ref) -> option<animation-snapshot>;
    queue-play-idle: func(entity: entity-ref, idle: form-ref);
}

/// Canonical fame and infamy axes keyed by authored REPU records.
interface reputation {
    use state.{entity-ref, form-ref};

    record reputation-entry {
        reputation: form-ref,
        fame: u16,
        infamy: u16,
    }

    record reputation-snapshot {
        entries: list<reputation-entry>,
        truncated: bool,
    }

    enum operation {
        add-fame,
        add-infamy,
        reset,
    }

    get: func(entity: entity-ref) -> option<reputation-snapshot>;
    queue: func(
        entity: entity-ref,
        reputation: form-ref,
        operation: operation,
        points: u16,
    );
}

/// Bounded spatial queries over live authored references. Results use
/// portable form identities and never expose ECS slots or engine pointers.
interface world-spatial {
    use state.{form-ref};

    record spatial-hit {
        reference: form-ref,
        x: f32,
        y: f32,
        z: f32,
        distance: f32,
    }

    record spatial-query-result {
        hits: list<spatial-hit>,
        truncated: bool,
    }

    nearby: func(x: f32, y: f32, z: f32, radius: f32, limit: u32) -> spatial-query-result;
}

/// Callback-local engine console arguments and bounded output. Commands are
/// declared in the authenticated manifest; guests cannot choose global names.
interface console {
    args-len: func() -> u32;
    args-byte: func(index: u32) -> option<u8>;
    write-line: func(message: string);
    set-failed: func();
}

/// Minimal lifecycle contract for the first executable-mod runtime slice.
world extension {
    import logging;
    import context;
    import events;
    import state;
    import legacy-containers;
    import storage;
    import world-state;
    import content-catalog;
    import actor-values;
    import inventory;
    import factions;
    import faction-relationships;
    import perks;
    import packages;
    import animation;
    import reputation;
    import world-spatial;
    import console;

    use state.{entity-ref, form-ref, hit-details, input-action, input-phase, session-phase};

    export initialize: func();
    export on-activate: func(subject: entity-ref, activator: option<entity-ref>);
    export on-cell-load: func(subject: entity-ref);
    export on-hit: func(
        subject: entity-ref,
        aggressor: option<entity-ref>,
        source: option<entity-ref>,
        projectile: option<entity-ref>,
        details: hit-details,
    );
    export on-equipment-change: func(
        wearer: entity-ref,
        item: form-ref,
        equipped: bool,
    );
    export on-input-action: func(action: input-action, phase: input-phase);
    export on-session-event: func(phase: session-phase, slot: option<u32>);
    export on-custom-event: func(subscription-index: u32);
    export on-update: func(elapsed-seconds: f32);
    export on-console-command: func(command-index: u32);
    export shutdown: func();
}
