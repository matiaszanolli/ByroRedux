# Playable-slice fixture — Fallout: New Vegas (#3039).
#
# FNV is the project's declared reference title and had no playable-slice
# gate at all before #3039 — only `m41-ragdoll.sh`. Every value below was
# derived from vanilla `FalloutNV.esm`, never guessed:
#
#   cargo run -p byroredux-plugin --example probe_slice_fixture -- \
#     "$BYROREDUX_FNV_DATA/FalloutNV.esm" GSProspectorSaloonInterior
#     → CELL 00106185, 461 REFRs, four XTEL doors; door 0010618E at
#       Z-up (64, -884, 3456) teleports to wastelandnv (-17,0) with the
#       arrival at Z-up (-67763.0, 3567.3, 8386.4) — Y-up (-67763, 8386,
#       -3567). The camera pose below is that probe's computed standoff
#       pose for door 0010618E, verified live to select it
#       (`kind=Door distance=67.64  prompt=[E] Open`).
#
#   cargo run -p byroredux-plugin --example probe_combat_fixture -- \
#     "$BYROREDUX_FNV_DATA/FalloutNV.esm" GSProspectorSaloonInterior
#     → GSTrudy ref=00104C6D base=00104C6C health=240.0.
#
# GSProspectorSaloonInterior is also the FNV bench-of-record cell, so the
# gate exercises the same content the performance record is taken on.

FIXTURE_LABEL="Fallout: New Vegas"
FIXTURE_DATA_ENV=BYROREDUX_FNV_DATA
FIXTURE_DATA_DEFAULT="/mnt/data/SteamLibrary/steamapps/common/Fallout New Vegas/Data"
FIXTURE_ESM="FalloutNV.esm"

# FNV ships no compiled-script archive (Papyrus is Skyrim+), so there is no
# `--scripts-bsa` entry — the fixture is the right place for that difference.
#
# #5257 — `Update.bsa` is the base game's own patch archive and mounts LAST
# in every pool (last-listed wins, #3637/#3896), mirroring the `--game fnv`
# profile's default_bsas/default_textures_bsas/default_sounds_bsas exactly
# (#3916: it is listed in all three pools). Without it, no live FNV gate
# exercised patch-archive precedence — the #3896 class passed every gate.
# None of its 55 NIFs lie on the fixture routes (Prospector / Goodsprings /
# Lake Mead), so the population floors are unchanged by mounting it.
FIXTURE_ARCHIVE_ARGS=(
    --bsa "Fallout - Meshes.bsa"
    --bsa "Update.bsa"
    --textures-bsa "Fallout - Textures.bsa"
    --textures-bsa "Update.bsa"
    --sounds-bsa "Fallout - Sound.bsa"
    --sounds-bsa "Update.bsa"
)

FIXTURE_REQUIRED_FILES=(
    "FalloutNV.esm"
    "Fallout - Meshes.bsa"
    "Fallout - Textures.bsa"
    "Fallout - Sound.bsa"
    "Update.bsa"
)

# #5257 — patch-archive mount evidence: the engine's archive-open log line
# ends with the path as passed, so a trailing-quote needle catches any
# Update.bsa open (mesh, texture, or sound pool). Asserted by the gates
# that read engine_stderr; other games' fixtures leave this empty.
FIXTURE_REQUIRED_ARCHIVE_LOGS=("Update.bsa'")

# ── P0 — door interaction ────────────────────────────────────────────────
P0_HEADLINE="Prospector Saloon -> WastelandNV"
P0_CELL="GSProspectorSaloonInterior"
# probe_slice_fixture's standoff pose for door 0010618E, Y-up.
P0_CAMERA_POS="45,3576,741"
P0_CAMERA_FORWARD="0.133,0,0.991"
P0_TARGET_KIND="kind=Door"
P0_PROMPT="prompt=[E] Open"
P0_QUEUE_LOG="activated; queued exterior 'wastelandnv' (-17,0)"
P0_APPLIED_LOG="exterior 'wastelandnv' (-17,0) at world"
P0_OUTCOME="outcome=ActivateEvent emitted; queued exterior 'wastelandnv' (-17,0)"
# Measured 2164 entities on this pose at 2026-10-07 (HEAD 75755796d);
# the 2026-08-27 figure this floor was first pinned against was 3056, but
# #4813/#4814 (2026-09-28, Initially Disabled / Starts Dead withholding —
# f87490826) correctly removed the saloon's scene-gated actor population
# (GSTrudy, JoeCobb and kin), matching ROADMAP's Prospector 3309→2359
# re-attribution. Floor set at the same ~82%-of-measured margin the
# fixture has always left; re-measure before raising, never lower blind.
P0_ENTITY_FLOOR=1750

# ── P1 — character traversal ─────────────────────────────────────────────
P1_HEADLINE="Prospector Saloon round trip"
P1_CELL="$P0_CELL"
P1_CAMERA_POS="$P0_CAMERA_POS"
P1_CAMERA_FORWARD="$P0_CAMERA_FORWARD"
P1_PROMPT="$P0_PROMPT"
P1_WALK_AWAY_FRAMES=120
P1_WALK_BACK_FRAMES=130
P1_OUTBOUND_LOG="Cell transition applied: → exterior 'wastelandnv' (-17,0)"
P1_ARRIVAL_GRID="grid=(-17,0)"
P1_RETURN_LOG="Cell transition applied: → interior 'GSProspectorSaloonInterior'"
P1_RETURN_OUTCOME="queued interior 'GSProspectorSaloonInterior'"
P1_ENTITY_FLOOR=1750

# Measured with the live capsule, 2026-09-16. The former straight -Z route
# went into the saloon wall at z=-3593, not along a traversable street.
# Back away from the porch into the road, then cross the WEST tile edge
# x=-69632 and retrace the road to the same authored exit. The measured
# crossing pair was (-69634,8484,-2459) -> (-69631,8484,-2463), grounded.
# A final north approach at x≈-67770 recovered the door prompt at z=-3396
# and completed the bound return activation. All legs use normal KCC input;
# collision, both streaming crossings and both door activations stay gated.
P1_ROUTE=(
    "until|backward|z|ge|-2450|20|leave saloon porch for road|grid=(-17,0)"
    "until|left|x|le|-69800|50|outbound west road boundary walk|grid=(-18,0)"
    "until|right|x|ge|-68000|50|inbound road boundary walk|grid=(-17,0)"
    "until|right|x|ge|-67790|20|align with saloon entrance|grid=(-17,0)"
    "until|forward|z|le|-3380|20|reverse-door approach|grid=(-17,0)"
)
P1_MIN_CROSSINGS=2
P1_EXPECT_LOADING_SCREEN=1

# ── P2 — melee core ──────────────────────────────────────────────────────
P2_HEADLINE="Prospector Saloon melee death"
P2_CELL="$P0_CELL"
P2_PROBE_CELL_LINE="CELL GSProspectorSaloonInterior form=00106185"
# Retargeted 2026-10-01 (#5156): the frozen GSTrudy ACHR 00104C6D is
# authored Initially Disabled (header flags 0x00000C00 — she and JoeCobb
# 00104C68 are the scene-gated bar-argument actors the enter-saloon scene
# enables), so the #4813 flag decode correctly withholds her NPC content and
# the 2026-09-17 fixture could no longer resolve her. GSSunnySmiles was
# tried first (live at start) but stands behind the bar table whose collider
# grounds the melee approach pose 120 BU out of swing range. GSSettlerCM
# 00104F08 is live at start (verified spawning in a live session) and stands
# on the open saloon floor, where the approach lands in range.
P2_PROBE_NPC_LINE="NPC ref=00104F08 base=00104F09"
# The settler carries a 9mm Pistol leaf, not a melee one; the weapon-family
# preflight is the Skyrim fixture's Draugr-specific check and has no FNV
# counterpart, so the list is deliberately empty rather than padded with an
# unrelated leaf.
P2_PROBE_WEAPON_LINES=()
P2_TARGET_NAME="gssettlercm"
P2_TARGET_REFR_LINE="REFR FormID:       0x104F08"
# #5238 — the authored NPC curve (base + 5·(END−1) + 5·(L−1)); GSSettlerCM
# derives 45.0 from her record (was 220.0 under the retired player curve).
# Re-derive with probe_combat_fixture (health=45.0 on the GSSettlerCM line).
P2_TARGET_HEALTH="45.0"
# The humanoid skeleton family the original GSTrudy runs pinned
# (2026-09-17); the settler shares it.
P2_RAGDOLL_BODIES=18
# Humanoid on the saloon floor: broad explosion/fall-through bound in BU,
# not a claim of exact pose fidelity or a universal ragdoll travel limit.
P2_RAGDOLL_MAX_DISTANCE=512
P2_BENCH_FRAMES=5

# ── W1 — water traversal (WATAL) ─────────────────────────────────────────
# Lake Mead, the older-generation half of the frozen W0 water pair. W0 pinned
# the *rendered* waterline from a fly camera at Tamriel-equivalent grid
# (19,13); W1 needs a walkable shore, and (19,13) has neither (it is open
# water end to end, and its foreground CELL carries a DoorTeleport that wins
# over `--camera-pos` in `plan_character_spawn`). The beach is one cell east.
#
# Derived live (2026-09-09), not guessed — `cam.pos` column probes with the
# real capsule at z=-55000, reading `player.status` after each settle:
#   x=82200 y=3078 dry · x=82700 y=2880 dry · x=82900 y=2674 dry
#   x=83100 swimming (depth 31) · x=81500 y=2622 wading (depth -22)
# so the waterline sits at x≈83000 with a ~22° approach, and the authored
# `WaterVolume` is [77824,-1496,-57344]..[81920,2600,-53248] (+ siblings),
# surface Y=2600, WATR 0x001009CA, calm (no authored flow).
W1_HEADLINE="Lake Mead shore -> swim -> dive -> shore"
W1_WORLDSPACE="WastelandNV"
W1_GRID="20,13"
# Dry sand ~300 BU short of the waterline. No foreground DoorTeleport here, so
# the spawn ladder's ray-cast rung honours this column.
W1_SHORE_POS="82700,3200,-55000"
W1_SHORE_FORWARD="1,-0.15,0"
# yaw -90° aims +X (into the lake), so `forward` enters and `backward` exits
# along the same axis.
W1_ENTER_YAW=-90
W1_ENTER_ACTION=forward
W1_EXIT_ACTION=backward
W1_WATER_SOURCE="0x001009CA"
# depth 100 > half_span (64) so the capsule is fully submerged and the camera
# (eye_height 52 above the body) is underwater too — that is what arms the
# hysteresis-strobe check.
W1_DIVE_DEPTH=100
# Walking on west past x=81920 leaves grid (20,13) for (19,13) through the
# wading shallows — the water-adjacent boundary crossing W1 asks for. Here the
# beach continues into the next cell, so the crossing comes *after* the exit
# and puts the player back in the water on the far side (measured: swimming at
# 81781/-55233), which is the harder case — the streaming reconcile runs while
# the capsule's only support is a water volume.
W1_BOUNDARY_PHASE=after-exit
W1_BOUNDARY_ACTION=backward
W1_BOUNDARY_GRID="grid=(19,13)"
W1_ENTITY_FLOOR=500
# One dive down + one surface = 2. The cap is deliberately loose: it is a
# strobe detector, and a strobing waterline produces dozens per second.
W1_MAX_WATERLINE_TRANSITIONS=8
