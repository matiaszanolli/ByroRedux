# Playable-slice fixture — Skyrim Special Edition (#3039).
#
# Values carried over verbatim from the pre-#3039 inline scripts, so the
# Skyrim gates behave byte-for-byte as they did at their 2026-08-10 close-out
# run. Re-derive with:
#   cargo run -p byroredux-plugin --example probe_slice_fixture -- \
#     "$BYROREDUX_SKYRIMSE_DATA/Skyrim.esm" WhiterunBanneredMare
#   cargo run -p byroredux-plugin --example probe_combat_fixture -- \
#     "$BYROREDUX_SKYRIMSE_DATA/Skyrim.esm" BleakFallsBarrow01

FIXTURE_LABEL="Skyrim Special Edition"
FIXTURE_DATA_ENV=BYROREDUX_SKYRIMSE_DATA
FIXTURE_DATA_DEFAULT="/mnt/data/SteamLibrary/steamapps/common/Skyrim Special Edition/Data"
FIXTURE_ESM="Skyrim.esm"

# #5674 — the gates with a MEASURED route on this title. Undeclared
# gates fail fast with "no measured route" instead of running an
# unmeasured one: the default game of every fixture-driven script is
# this file, and p5-soak on the P0 door route failed confusingly at
# cycle 2 (its route was only ever measured on FNV — the p5 family's
# reference). p5-* live on fnv/fo3; Skyrim's persistence gate is the
# separately-scripted p5-quest-persistence. Extend this list only after
# a green measured run.
FIXTURE_GATES=(p0-door-interaction p1-character-traversal p2-melee-core p6-loading-model w1-water-traversal)

# Archive arguments, relative to the data dir. `--flag` entries pass through;
# every other entry is prefixed with the resolved data directory.
FIXTURE_ARCHIVE_ARGS=(
    --bsa "Skyrim - Meshes0.bsa"
    --bsa "Skyrim - Animations.bsa"
    --textures-bsa "Skyrim - Textures0.bsa"
    --scripts-bsa "Skyrim - Misc.bsa"
    --sounds-bsa "Skyrim - Sounds.bsa"
)

FIXTURE_REQUIRED_FILES=(
    "Skyrim.esm"
    "Skyrim - Meshes0.bsa"
    "Skyrim - Animations.bsa"
    "Skyrim - Textures0.bsa"
    "Skyrim - Misc.bsa"
    "Skyrim - Sounds.bsa"
)

# ── P0 — door interaction ────────────────────────────────────────────────
# WhiterunBanneredMare's vanilla XTEL exit. The camera pose is a stable
# fly-camera preflight aimed at that authored door.
P0_HEADLINE="Bannered Mare -> WhiterunWorld"
P0_CELL="WhiterunBanneredMare"
P0_CAMERA_POS="-116,226,982"
P0_CAMERA_FORWARD="0,-0.29,0.96"
P0_TARGET_KIND="kind=Door"
P0_PROMPT="prompt=[E] Open"
P0_QUEUE_LOG="activated; queued exterior 'whiterunworld' (6,-2)"
P0_APPLIED_LOG="exterior 'whiterunworld' (6,-2) at world"
P0_OUTCOME="outcome=ActivateEvent emitted; queued exterior 'whiterunworld' (6,-2)"
P0_ENTITY_FLOOR=3000

# ── P1 — character traversal ─────────────────────────────────────────────
P1_HEADLINE="Bannered Mare round trip"
P1_CELL="$P0_CELL"
P1_CAMERA_POS="$P0_CAMERA_POS"
P1_CAMERA_FORWARD="$P0_CAMERA_FORWARD"
P1_PROMPT="$P0_PROMPT"
P1_WALK_AWAY_FRAMES=120
P1_WALK_BACK_FRAMES=130
P1_OUTBOUND_LOG="Cell transition applied: → exterior 'whiterunworld' (6,-2)"
P1_ARRIVAL_GRID="grid=(6,-2)"
P1_RETURN_LOG="Cell transition applied: → interior 'WhiterunBanneredMare'"
P1_RETURN_OUTCOME="queued interior 'WhiterunBanneredMare'"
P1_ENTITY_FLOOR=3000

# Exterior route. Two leg forms, both driven through held gameplay input:
#   hold   <action> <frames> <description>            [expect-grid <token>]
#   until  <action> <axis> <le|ge> <target> <chunk> <description>
#                                                      [expect-grid <token>]
# `expect-grid` asserts the player's streamed grid after that leg — the
# streaming-boundary half of the gate. Collision-stable authored-road
# waypoints, calibrated 2026-08-10; coordinate gates keep the route
# independent of renderer FPS.
P1_ROUTE=(
    "hold|left|700|exterior road approach"
    "hold|backward|700|outbound exterior boundary walk|grid=(6,-3)"
    "until|forward|z|le|8050|30|inbound exterior boundary walk|grid=(6,-2)"
    "until|forward|z|le|7600|30|return road south leg"
    "until|right|x|ge|25120|50|return road east leg one"
    "until|backward|z|ge|7700|30|return road north jog"
    "until|right|x|ge|25420|50|return road east leg two"
    "until|forward|z|le|7550|30|return road south jog"
    "until|right|x|ge|25620|50|return road east leg three"
    "until|backward|z|ge|7670|30|reverse-door approach"
)
P1_MIN_CROSSINGS=2

# ── P2 — melee core ──────────────────────────────────────────────────────
# The frozen Bleak Falls Draugr.
P2_HEADLINE="Bleak Falls Draugr melee death"
P2_CELL="BleakFallsBarrow01"
P2_PROBE_CELL_LINE="CELL BleakFallsBarrow01 form=000371DE"
P2_PROBE_NPC_LINE="NPC ref=000383F7 base=000E9895"
# Re-derived from a live `probe_combat_fixture` run (#3417) rather than
# by hand. The frozen target's `LItemDraugr02Weapon2H` (`00024300`)
# authors both `DraugrBattleAxe` (`0001CB64`) and `DraugrGreatsword`
# (`000236A5`) at level 1, but `expand_leveled_form_id` is deliberately
# single-pick and RNG-free (#3217) — with `LVLF` bit 2 clear it takes
# the highest-level eligible entry, and the level-1 tie resolves to the
# last one authored. The battle axe is therefore unreachable by
# construction, and pinning it made this gate RED from the commit that
# introduced the fixture. Both lines below are leaves the probe really
# emits for `BleakFallsBarrow01`: the target's own two-hander and the
# one-handed draugr leaf carried by the rest of its family.
P2_PROBE_WEAPON_LINES=(
    "000236A5:DraugrGreatsword:damage=17"
    "0002C672:DraugrWarAxe:damage=9"
)
P2_TARGET_NAME="encdraugr01ambushmelee2hheadm06"
P2_TARGET_REFR_LINE="REFR FormID:       0x0383F7"
P2_TARGET_HEALTH="50.0"
# Empty = assert only that a ragdoll activated, without pinning the body
# count. Skyrim's fixture pins it because the 18-body figure is a measured
# close-out value for this exact reference.
P2_RAGDOLL_BODIES=18
# Grounded humanoid fixture; reject runaway/fall-through physics after load.
P2_RAGDOLL_MAX_DISTANCE=512
P2_BENCH_FRAMES=5

# ── P3 — native HUD ──────────────────────────────────────────────────────
# The P1 spawn pose at the Bannered Mare threshold. MS01 "The Forsworn
# Conspiracy" (0x00018B4B): stage 15's fragment lowers to
# SetObjectiveDisplayed(objective 10) — derived with
# `cargo run -p byroredux-scripting --example dump_stage_fragment_effects`
# against the installed master. Stage 10 displays nothing, which the first
# capture asserts the hard way.
P3_CELL="$P0_CELL"
P3_CAMERA_POS="$P0_CAMERA_POS"
P3_CAMERA_FORWARD="$P0_CAMERA_FORWARD"
P3_QUEST=0x18B4B
P3_QUEST_LABEL="MS01 stage-15 fragment"
P3_QUEST_STAGE=15
P3_QUEST_OBJECTIVE_LINE='10: displayed=true'
# CHARAL vital pools (Health / Magicka / Stamina) and the fill colors
# crates/debug-ui/src/panels.rs `vital_color` paints for them.
P3_VITAL_COLORS=("health:198,58,48" "magicka:72,110,220" "stamina:74,168,88")
# `modav <player> <AVIF> <delta>` probes run before the captures.
P3_MODAV=("0x3E8 5")

# ── W1 — water traversal (WATAL) ─────────────────────────────────────────
# The northern sea shore, Tamriel (-9,-16): open water at surface Y=600 with a
# gentle, clutter-free beach, found with `crates/plugin/examples/shore_probe.rs`
# (a gentle monotone LAND descent into water, with gentle dry ground continuing
# inland across a cell edge) and then walked live with the real capsule. The
# heightfield cannot see statics, so every transect is a candidate until
# `input.hold` has driven it; of the ones walked on 2026-10-26 this is the one
# where wading, swimming, the climb out and the inland walk all ran clear.
#
# Why not the rivers, which is where Skyrim's authored water mostly is:
#  - Riverwood (Tamriel (4,-11)): the bank north of the river wedges the
#    controller. From (18441.87,-150.58,42821.87) `forward` and `backward`
#    produced zero displacement for 360 frames while `left` moved the capsule
#    370 BU.
#  - The far-west river (Tamriel (-23,14), RiverWater 0x000E717C) swims, dives
#    to its 62-68 BU bed and climbs out, but the current drifts the swimmer ~90
#    BU sideways onto bank clutter that blocks `backward` ((-92439,-12751,
#    -59681): 0 BU in 480 frames, `left` free), and steering the exit east
#    only slides the capsule back into the same pocket.
#  - (-6,-16) and (32,-22) refused `forward` at the spawn.
# This sea shore has no current to push the capsule off its line.
W1_HEADLINE="Northern sea shore (-9,-16) -> swim -> dive -> shore"
W1_WORLDSPACE="Tamriel"
W1_GRID="-9,-16"
W1_SHORE_POS="-33024,1000,64640"
W1_SHORE_FORWARD="0,-0.15,-1"
# yaw 0 aims -Z (into the sea), so `forward` enters and `backward` exits.
W1_ENTER_YAW=0
W1_ENTER_ACTION=forward
W1_EXIT_ACTION=backward
W1_WATER_SOURCE="0x00000018"
W1_DIVE_DEPTH=100
# Inland (`backward`, +Z) the cell edge at Z=65536 is 896 BU behind the start,
# over gentle dry ground.
W1_BOUNDARY_PHASE=after-exit
W1_BOUNDARY_ACTION=backward
W1_BOUNDARY_GRID="grid=(-9,-17)"
W1_ENTITY_FLOOR=500
W1_MAX_WATERLINE_TRANSITIONS=8
