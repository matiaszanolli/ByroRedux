# Playable-slice fixture — Oblivion (#3039).
#
# Derived from vanilla Oblivion.esm with:
#   cargo run -p byroredux-plugin --example probe_slice_fixture -- \
#     "$BYROREDUX_OBLIVION_DATA/Oblivion.esm" AnvilHeinrichOakenHallsHouse
#
# AbandonedMine's REFR 00033AD4 is an unlocked exterior XTEL door. The
# previous Heinrich Oaken-Halls candidate was authored locked, so it could
# never produce an activation prompt under the engine's lock policy.

FIXTURE_LABEL="Oblivion"
FIXTURE_GATES=(p0-door-interaction)
FIXTURE_DATA_ENV=BYROREDUX_OBLIVION_DATA
FIXTURE_DATA_DEFAULT="/mnt/data/SteamLibrary/steamapps/common/Oblivion/Data"
FIXTURE_ESM="Oblivion.esm"
FIXTURE_ARCHIVE_ARGS=(
    --bsa "Oblivion - Meshes.bsa"
    --textures-bsa "Oblivion - Textures - Compressed.bsa"
)
FIXTURE_REQUIRED_FILES=(
    "Oblivion.esm"
    "Oblivion - Meshes.bsa"
    "Oblivion - Textures - Compressed.bsa"
)

# ── P0 — door interaction ────────────────────────────────────────────────
P0_HEADLINE="Abandoned Mine -> Tamriel"
P0_CELL="AbandonedMine"
P0_CAMERA_POS="1263,6257,-2129"
P0_CAMERA_FORWARD="-0.002,0.088,-0.996"
P0_TARGET_KIND="kind=Door"
P0_PROMPT="prompt=[E] Open"
P0_QUEUE_LOG="activated; queued exterior 'tamriel' (47,-4)"
P0_APPLIED_LOG="exterior 'tamriel' (47,-4) at world"
P0_OUTCOME="outcome=ActivateEvent emitted; queued exterior 'tamriel' (47,-4)"
# The observed initial scene contains 315 references; retain room for archive
# and renderer-side filtering without allowing an almost-empty scene through.
P0_ENTITY_FLOOR=250
