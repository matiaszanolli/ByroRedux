# Playable-slice fixture — Fallout 4.
#
# This declares only the measured P0 door and P2 combat routes. Remaining
# gates stay configuration errors until their character routes have been
# exercised against the installed vanilla data, rather than turning a
# convenient Med-Tek cell into implied full-game coverage.
#
# Derived with:
#   cargo run -p byroredux-plugin --example probe_slice_fixture -- \
#     "$BYROREDUX_FO4_DATA/Fallout4.esm" MedTekResearch01

FIXTURE_LABEL="Fallout 4"
FIXTURE_GATES=(p0-door-interaction p2-melee-core)
FIXTURE_DATA_ENV=BYROREDUX_FO4_DATA
FIXTURE_DATA_DEFAULT="/mnt/data/SteamLibrary/steamapps/common/Fallout 4/Data"
FIXTURE_ESM="Fallout4.esm"

# Med-Tek uses both base and precombined mesh archives.  Materials are passed
# separately because BGSM resolution is not a texture lookup.
FIXTURE_ARCHIVE_ARGS=(
    --bsa "Fallout4 - Meshes.ba2"
    --bsa "Fallout4 - MeshesExtra.ba2"
    --textures-bsa "Fallout4 - Textures1.ba2"
    --materials-ba2 "Fallout4 - Materials.ba2"
)
FIXTURE_REQUIRED_FILES=(
    "Fallout4.esm"
    "Fallout4 - Meshes.ba2"
    "Fallout4 - MeshesExtra.ba2"
    "Fallout4 - Textures1.ba2"
    "Fallout4 - Materials.ba2"
)

# ── P0 — door interaction ────────────────────────────────────────────────
# Exterior exit 000456BA, derived standoff camera in Y-up coordinates.  The
# entity floor has a wide margin below the probe's 4,397 authored references;
# it detects partial cell construction without pretending the count is exact.
P0_HEADLINE="Med-Tek Research -> Commonwealth"
P0_CELL="MedTekResearch01"
P0_CAMERA_POS="-1578,120,-860"
P0_CAMERA_FORWARD="0.513,0.000,0.859"
P0_TARGET_KIND="kind=Door"
P0_PROMPT="prompt=[E] Open"
P0_QUEUE_LOG="activated; queued exterior 'commonwealth' (5,13)"
P0_APPLIED_LOG="exterior 'commonwealth' (5,13) at world"
P0_OUTCOME="outcome=ActivateEvent emitted; queued exterior 'commonwealth' (5,13)"
P0_ENTITY_FLOOR=3000

# ── P2 — melee core ──────────────────────────────────────────────────────
# First grounded feral-ghoul reference from the vanilla Med-Tek combat probe.
# Its skeleton has no authored bone bodies, so P2 explicitly gates the
# conservative one-body fallback corpse rather than implying multi-bone
# ragdoll fidelity.
P2_HEADLINE="Med-Tek feral ghoul melee death"
P2_CELL="$P0_CELL"
P2_PROBE_CELL_LINE="CELL MedTekResearch01 form=0003DF34"
P2_PROBE_NPC_LINE="NPC ref=00084CEC base=00075337"
P2_PROBE_WEAPON_LINES=()
P2_TARGET_NAME="lvlferalghoul"
P2_TARGET_REFR_LINE="REFR FormID:       0x084CEC"
# The live template/race resolution yields 180.0; P2 gates that value.
P2_TARGET_HEALTH="180.0"
P2_RAGDOLL_BODIES=1
P2_RAGDOLL_MAX_DISTANCE=512
P2_BENCH_FRAMES=30
