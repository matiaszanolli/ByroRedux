# Fallout 3: measured door, persistence, and combat routes; traversal remains
# unmeasured.
# Derived with probe_slice_fixture against Fallout3.esm:
# CELL MegatonMoriartysSaloon 00003A35, 458 refs; door 00003A5F.
# Probe's interior standoff camera (Y-up): 1110,-7,-2, facing -0.980,0,-0.201.
FIXTURE_LABEL="Fallout 3"
# p5-f5-f9-quicksave rides the same measured P1 fields as p5-save-restart
# (Moriarty's Saloon standoff + loading-cover lifecycle), measured 2026-09-17.
FIXTURE_GATES=(p0-door-interaction p5-save-restart p5-f5-f9-quicksave p2-melee-core)
FIXTURE_DATA_ENV=BYROREDUX_FO3_DATA
FIXTURE_DATA_DEFAULT="/mnt/data/SteamLibrary/steamapps/common/Fallout 3 goty/Data"
FIXTURE_ESM="Fallout3.esm"
FIXTURE_ARCHIVE_ARGS=(
    --bsa "Fallout - Meshes.bsa"
    --textures-bsa "Fallout - Textures.bsa"
    --sounds-bsa "Fallout - Sound.bsa"
)
FIXTURE_REQUIRED_FILES=(
    "Fallout3.esm"
    "Fallout - Meshes.bsa"
    "Fallout - Textures.bsa"
    "Fallout - Sound.bsa"
)

# ── P0 — door interaction ────────────────────────────────────────────────
# Door 00003A5F is the probe's first authored Megaton exit.
P0_HEADLINE="Moriarty's Saloon -> MegatonWorld"
P0_CELL="MegatonMoriartysSaloon"
P0_CAMERA_POS="1110,-7,-2"
P0_CAMERA_FORWARD="-0.980,0.000,-0.201"
P0_TARGET_KIND="kind=Door"
P0_PROMPT="prompt=[E] Open"
P0_QUEUE_LOG="activated; queued exterior 'megatonworld' (-1,-7)"
P0_APPLIED_LOG="exterior 'megatonworld' (-1,-7) at world"
P0_OUTCOME="outcome=ActivateEvent emitted; queued exterior 'megatonworld' (-1,-7)"
P0_ENTITY_FLOOR=300

P1_CELL="MegatonMoriartysSaloon"
P1_CAMERA_POS="1110,-7,-2"
P1_CAMERA_FORWARD="-0.980,0.000,-0.201"
# Observed on save restore: LSCR 0002186A, loading_junktown.dds.
P1_EXPECT_LOADING_SCREEN=1

# Derived with probe_combat_fixture from the same installed master.
P2_HEADLINE="Moriarty's Saloon Nova melee death"
P2_CELL="$P1_CELL"
P2_PROBE_CELL_LINE="CELL MegatonMoriartysSaloon form=00003A35"
# Retargeted 2026-10-01 (#5156): the frozen MoriartysCustomer01 ACHR
# 00041709 is authored Initially Disabled (header flags 0x00000C00 — the
# scene-gated saloon customers), so the #4813 flag decode correctly withholds
# its NPC content and the 2026-09-17 fixture could no longer resolve. Nova
# 00003B3F is live at start (flags 0x00000400) and carries no authored
# weapon leaf, so the weapon-family pin is deliberately empty (FNV
# precedent) rather than padded with an unrelated row.
P2_PROBE_NPC_LINE="NPC ref=00003B3F base=00000A63"
P2_PROBE_WEAPON_LINES=()
P2_TARGET_NAME="nova"
P2_TARGET_REFR_LINE="REFR FormID:       0x03B3F"
P2_TARGET_HEALTH="210.0"
P2_BENCH_FRAMES=30
# Measured in the first live run; its restored physics failed the finite gate.
P2_RAGDOLL_BODIES=18
# Same broad humanoid stability bound as FNV, not exact pose fidelity.
P2_RAGDOLL_MAX_DISTANCE=512
