+size_t byro_xwma_wmav2_scratch_frame_slots(void)
+{
+    /* Overlap slots are channel-paired. The full IMDCT writes one channel
+     * at a time into the shared work buffer. */
+    return sizeof(((WMACodecContext *)0)->frame_out[0]) / sizeof(float)
+         + sizeof(((WMACodecContext *)0)->output) / sizeof(float);
 }

