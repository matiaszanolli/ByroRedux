/target
**/*.rs.bk
*.pdb
.env

# Third-party dev tools (cloned locally, not tracked) — except our workspace tools
/tools/*
!/tools/byro-dbg/
!/tools/byro-detect/
!/tools/byro-launcher/
!/tools/texture-upscale/
pipeline_cache.bin
GEMINI.md

# codebase-memory-mcp's local index cache — regenerated by index_repository,
# churns every session (27 MB compressed graph blob), not source of truth
.codebase-memory/

# MCP server config — carries a personal Apify API token, do NOT commit
.mcp.json
.codex/config.toml

# #3746 — one-shot audit-probe example binaries. `crates/*/examples/_tmp_*`
# is the established scratch-probe naming convention (see any historical
# `/audit-*` skill); ignoring it here makes "don't commit scratch probes"
# self-enforcing instead of relying on session discipline. #3150/#3746
# already swept the 98 that had accumulated in git history before this
# rule landed — this only prevents new ones from landing the same way.
# A probe worth keeping should lose the `_tmp_` prefix and get a real,
# documented name (see watr_wind_census.rs, esm_dim8_bench.rs, sf_smoke.rs).
# #5114 — the bare `tmp_` spelling is equally scratch: three `tmp_fo4_d4_*`
# probes sat committed for weeks because only `_tmp_` was covered here and
# in workspace_hygiene_tests.rs.
crates/*/examples/_tmp_*
crates/*/examples/tmp_*

# #4080 — merge/patch artifacts. One (parse_real_esm.rs.orig, ef85f7be)
# slipped in and rotted 86 lines behind its live sibling with no rule to
# catch it.
*.orig
*.rej

# Release tarballs (scripts/package-release.sh)
/dist/

# Python bytecode (scripts/m-light tools)
__pycache__/

# A screenshot taken from the repo root (the engine writes them under screenshots/, #6933).
/screenshot_*.png

# xWMA PRD, #7413 — the vendored FFmpeg (third_party/ffmpeg/PATCHES.md) is built out of tree by
# crates/xwma/build.rs into cargo's OUT_DIR, which is under /target. These rules only guard against a
# `configure` or `make` run inside the vendored tree: they cover exactly what those generate (measured on
# the V7 build of FFmpeg 9.1) and nothing that ships in the release tarball. Re-check them on a re-vendor.
/third_party/ffmpeg/ffmpeg-*/.version
/third_party/ffmpeg/ffmpeg-*/config.h
/third_party/ffmpeg/ffmpeg-*/config_components.h
/third_party/ffmpeg/ffmpeg-*/checkasm_*_generated.h
/third_party/ffmpeg/ffmpeg-*/ffbuild/.config
/third_party/ffmpeg/ffmpeg-*/ffbuild/config.*
/third_party/ffmpeg/ffmpeg-*/doc/config.texi
/third_party/ffmpeg/ffmpeg-*/doc/examples/pc-uninstalled/
/third_party/ffmpeg/ffmpeg-*/libav*/*.pc
/third_party/ffmpeg/ffmpeg-*/libav*/*.version
/third_party/ffmpeg/ffmpeg-*/libavcodec/bsf_list.c
/third_party/ffmpeg/ffmpeg-*/libavcodec/codec_list.c
/third_party/ffmpeg/ffmpeg-*/libavcodec/parser_list.c
/third_party/ffmpeg/ffmpeg-*/libavdevice/indev_list.c
/third_party/ffmpeg/ffmpeg-*/libavdevice/outdev_list.c
/third_party/ffmpeg/ffmpeg-*/libavfilter/filter_list.c
/third_party/ffmpeg/ffmpeg-*/libavformat/demuxer_list.c
/third_party/ffmpeg/ffmpeg-*/libavformat/muxer_list.c
/third_party/ffmpeg/ffmpeg-*/libavformat/protocol_list.c
/third_party/ffmpeg/ffmpeg-*/libavutil/avconfig.h
/third_party/ffmpeg/ffmpeg-*/libavutil/ffversion.h
/third_party/ffmpeg/ffmpeg-*/**/*.o
/third_party/ffmpeg/ffmpeg-*/**/*.d
/third_party/ffmpeg/ffmpeg-*/**/*.a
